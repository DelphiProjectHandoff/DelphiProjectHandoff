object HelpTab: TTabItem
Text = 'Getting started'
object HelpFallback: TMemo
Align = Client
ReadOnly = True
WordWrap = True
TextSettings.Font.Size = 16
Lines.Strings = (
'Welcome to Delphi Project Handoff'
''
'1. Choose Debug / Win32 and enter required compiler defines.'
'2. Choose Attach project; select a .dproj, .dpr or .groupproj.'
'3. Save its .dphdb database in the proposed Databases folder, or choose another location outside the selected source folder.'
'4. Read the status line along the bottom of the window. PARTIAL means incomplete evidence.'
'5. Click Learn the project, then Coverage and troubleshooting in its topic list to read the gaps.'
'6. In that same topic list, click How the program starts.'
'7. In that same topic list, click Screens and user actions; choose a control link.'
'8. Read Explain for callers, decisions and outputs. Selection details on the right identifies the object.'
'9. Click Source for exact code, or Knowledge to record a named author answer.'
'10. Click Publish to export a bundle after reviewing exclusions and privacy.'
''
'Open cache shows saved historical evidence without executing the program.'
'Open cache starts in Databases; browse to an existing database if it is elsewhere. Existing databases have not been moved.'
'DPH rejects its own project and caches of itself. A rejected selection keeps your current workspace.'
'Form designs are approximate reconstructions. Screenshots imports actual PNG images you supply.'
'DPH never compiles or executes the selected application during analysis.'
''
'Full directions: docs/guides/DPH_User_Guide.docx and docs/pdf/DPH_User_Guide.pdf.'
)
end
object HelpBrowser: TWebBrowser
Align = Client
