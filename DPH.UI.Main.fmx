end
object ValidationMemo: TMemo
Align = Client
ReadOnly = True
WordWrap = True
StyledSettings = []
TextSettings.Font.Size = 14
Lines.Strings = ('1. Enter the separately retained expected input fingerprint, or click Use opened capture fingerprint after opening a trusted project database.' '2. Click Select manifest and validate bundle. Select manifest.json at the root of the intended bundle.' '3. Read PASS or FAILED and the reason. Stale/partial bundles are rejected by default.' '4. Enable historical/partial inspection only when deliberately inspecting an older or incomplete capture. This does not establish source currency, complete analysis, human review or author identity.')
end
end
