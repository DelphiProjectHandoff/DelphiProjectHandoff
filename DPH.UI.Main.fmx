Position.Y = 152
Width = 240
Height = 28
Text = 'Optional authored-body translation locale'
end
object PublishLocaleEdit: TEdit
Position.X = 250
Position.Y = 152
Width = 320
Height = 28
TextPrompt = 'Blank = source language; e.g. fr or fr-CA'
Hint = 'Uses exact saved reviewed translations. Missing or unreviewed sections retain source text. Generated guidance and titles remain source language.'
ShowHint = True
end
object PublishSourceNavigation: TCheckBox
Position.X = 4
Position.Y = 112
Width = 570
Height = 28
Text = 'Include redacted source browsing pages (review before sharing)'
IsChecked = False
Hint = 'Reads only hash-matching captured text. Original source bytes are not copied. Redaction cannot guarantee removal of every sensitive value.'
ShowHint = True
end
object PublishAgentInstructions: TCheckBox
Position.X = 4
Position.Y = 78
Width = 570
Height = 28
Text = 'Include generated agent boundaries (does not copy owner AGENTS.md)'
IsChecked = False
end
object PublishScopeCombo: TComboBox
Position.X = 4
Position.Y = 4
Width = 190
Height = 28
Items.Strings = ('Full project' 'Selected object and context')
ItemIndex = 0
end
object PublishExclusionsEdit: TEdit
Position.X = 200
Position.Y = 4
Width = 380
Height = 28
TextPrompt = 'Exclude relative files or folders; separated'
end
object PublishButton: TButton
Position.X = 4
Position.Y = 42
Width = 180
Text = 'Export HTML guides and AI bundle'
OnClick = PublishClick
end
object PreviewButton: TButton
Position.X = 200
Position.Y = 42
Width = 150
Enabled = False
Text = 'Preview offline HTML'
OnClick = PreviewClick
end
object PublishAudienceCombo: TComboBox
Position.X = 360
Position.Y = 42
Width = 210
Height = 28
Items.Strings = ('all' 'engineer' 'user' 'maintainer' 'builder' 'agent')
ItemIndex = 0
Hint = 'Guide audience; does not replace file exclusions'
ShowHint = True
end
end
object PublishMemo: TMemo
Align = Top
Height = 140
ReadOnly = True
end
object PublishBrowser: TWebBrowser
Align = Client
Visible = False
WindowsEngine = None
EnableCaching = False
OnShouldLoadURL = BrowserShouldLoad
end
end
end
