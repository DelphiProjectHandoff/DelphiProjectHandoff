object HelpTab: TTabItem
Text = 'Getting started'
object HelpFallback: TMemo
Align = Client
ReadOnly = True
TextSettings.Font.Size = 16
Lines.Strings = (
'Welcome to Delphi Project Handoff'
''
'1. Choose Debug / Win32 and enter required compiler defines.'
'2. Choose Attach project; select a .dproj, .dpr or .groupproj.'
'3. Save its .dphdb knowledge database outside the source folder.'
'4. Wait for the captured generation; check PARTIAL and coverage gaps.'
'5. Open Learn the project, then How the program starts.'
'6. Choose a familiar control in Screens and user actions.'
'7. Follow its event into Explain; inspect callers, branches and outputs.'
'8. Use Source for exact code, Knowledge for attributed author answers.'
'9. Publish an offline bundle after reviewing exclusions and privacy.'
''
'Open cache shows saved historical evidence without executing the program.'
'Form designs are approximate reconstructions. Screenshots imports actual PNG images you supply.'
'DPH never compiles or executes the selected application during analysis.'
''
'Full directions: docs/guides/DPH_User_Guide.docx and docs/pdf/DPH_User_Guide.pdf.'
)
end
object HelpBrowser: TWebBrowser
