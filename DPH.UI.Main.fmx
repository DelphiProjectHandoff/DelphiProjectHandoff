object DatabaseDialog: TSaveDialog
DefaultExt = 'dphdb'
Filter = 'DPH knowledge database|*.dphdb'
InitialDir = 'Databases'
Title = 'Save knowledge database outside the analyzed source folder'
end
object ExportDialog: TSaveDialog
Title = 'Choose a new export folder name outside the analyzed source'
Filter = 'Handoff folder name|*.*'
end
object ScreenshotDialog: TOpenDialog
Filter = 'PNG screenshot|*.png'
Title = 'Select an existing screenshot; DPH does not run the selected application'
end
object ObservationDialog: TOpenDialog
Filter = 'Saved UTF-8 observations|*.txt;*.log;*.json'
Title = 'Select an existing saved observation (up to 256 KiB); no program will run'
end
object ValidationDialog: TOpenDialog
Filter = 'Handoff manifest|manifest.json'
Title = 'Select manifest.json in the handoff bundle root'
end
object TranslationDialog: TOpenDialog
Filter = 'DAT language pack|*.json'
Title = 'Select an offline DAT language pack for DelphiProjectHandoff'
end
object TerminologyDialog: TOpenDialog
Filter = 'Exact prose terminology dictionary|*.json'
Title = 'Select a local exact prose-to-prose JSON dictionary'
end
object PollTimer: TTimer
Interval = 100
OnTimer = PollTimerTimer
end
object ChangeTimer: TTimer
Interval = 10000
Enabled = False
OnTimer = ChangeTimerTimer
end
end
