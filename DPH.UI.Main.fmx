object HelpTab: TTabItem
Text = 'Getting started'
object HelpFallback: TMemo
Align = Client
ReadOnly = True
WordWrap = True
TextSettings.Font.Size = 16
Lines.Strings = (
'Build a source-backed maintenance handoff for an unfamiliar Delphi application.'
''
'1. Click Open application at the top left and select its .dproj, .dpr or .groupproj file.'
'2. Explore without saving. When you close DPH or open another project, choose Yes to save or No to discard; Open saved project restores a saved .dphdb.'
'3. Handoff dossier summarizes purpose, startup, commands, data and open questions.'
'4. Learning library lists topics from this application''s guides and help.'
'5. Screenshots shows available application images in fitted or native size.'
''
'Project map identifies forms, controls and connected actions. Application diagrams show supported connections.'
'DPH does not invent screenshots when an application provides none.'
'DPH reads the application files without changing or running them.'
)
end
object HelpBrowser: TWebBrowser
Align = Client
Visible = False
WindowsEngine = None
EnableCaching = False
OnShouldLoadURL = LearningShouldLoad
end
end
