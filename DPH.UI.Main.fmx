object LifecycleTab: TTabItem
Text = 'Database tools'
object LifecyclePurpose: TLabel
Align = Top
Height = 110
Margins.Left = 12
Margins.Right = 12
WordWrap = True
Text = 'Retention controls remove older cached view files, preserving immutable analysis facts and authored history. Set the number of recent generations, then Preview retention to inspect the policy. Keep current release protects the displayed generation under the label and reviewer you enter. Apply retention removes only eligible cached views; it keeps the baseline, published head, latest available generation, retained releases and linked review/screenshot evidence.'
end
