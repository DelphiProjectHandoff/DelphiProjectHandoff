object ProjectSearchPurpose: TLabel
Align = Top
Height = 90
Margins.Left = 12
Margins.Right = 12
WordWrap = True
Text = 'Search source objects, captured flow evidence, diagnostics and authored knowledge. Enter up to twelve words and click Search. Each word matches the beginning of an indexed word; all words must match. Select a result for its excerpt, then Open result to visit its object or note. Review status stays separate from static evidence. Use the page selector beside Getting started to reach any workspace page when tabs do not fit.'
end
