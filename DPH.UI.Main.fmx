object DPHMainForm: TDPHMainForm
  Caption = 'Delphi Project Handoff - Experimental Software'
  ClientWidth = 1400
  ClientHeight = 850
  Fill.Color = claWhite
  OnCreate = FormCreate
  OnDestroy = FormDestroy
  OnCloseQuery = FormCloseQuery
  FormFactor.Devices = [Desktop]
object HeaderLayout: TLayout
Align = Top
Height = 56
object BaselineLabel: TLabel
