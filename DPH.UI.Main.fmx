  object QualityTab: TTabItem
    Text = 'Source quality'
    object QualityPurpose: TLabel
      Align = Top
      Height = 90
      Margins.Left = 12
      Margins.Right = 12
      WordWrap = True
      Text = 'Inspect routine metrics, potential duplicate bodies, missing incoming references, disconnected statements and call cycles. These are source-based investigation candidates. They do not prove unused code, equivalent behavior, runtime recursion or safe deletion. Select a row for evidence and explanation.'
    end
