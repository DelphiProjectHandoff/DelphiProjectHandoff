object OpenProjectDialog: TOpenDialog
Filter = 'Delphi projects|*.dproj;*.dpr;*.groupproj'
end
object OpenCacheDialog: TOpenDialog
Filter = 'DPH knowledge database|*.dphdb'
end
object DatabaseDialog: TSaveDialog
DefaultExt = 'dphdb'
Filter = 'DPH knowledge database|*.dphdb'
Title = 'Save knowledge database outside the analyzed source folder'
end
object ExportDialog: TSaveDialog
Title = 'Choose a new export folder name outside the analyzed source'
Filter = 'Handoff folder name|*.*'
end
object ScreenshotDialog: TOpenDialog
Filter = 'PNG screenshot|*.png'
Title = 'Select an existing screenshot; DPH does not run the selected application'
end
object PollTimer: TTimer
Interval = 100
OnTimer = PollTimerTimer
end
object ChangeTimer: TTimer
Interval = 10000
OnTimer = ChangeTimerTimer
end
