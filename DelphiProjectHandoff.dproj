<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <ProjectGuid>{D9484A29-FD59-48ED-8C14-4E3D966C4DCF}</ProjectGuid>
    <ProjectVersion>20.4</ProjectVersion>
    <FrameworkType>FMX</FrameworkType>
    <MainSource>DelphiProjectHandoff.dpr</MainSource>
    <Base>True</Base>
    <Config Condition="'$(Config)'==''">Debug</Config>
    <Platform Condition="'$(Platform)'==''">Win32</Platform>
    <AppType>Application</AppType>
    <TargetedPlatforms>1</TargetedPlatforms>
    <DCC_Namespace>System;Xml;Data;Datasnap;Web;Soap;FMX;$(DCC_Namespace)</DCC_Namespace>
    <DCC_DcuOutput>dcu\$(Platform)\$(Config)</DCC_DcuOutput>
    <DCC_ExeOutput>bin\$(Platform)\$(Config)</DCC_ExeOutput>
    <DCC_UnitSearchPath>dependencies\DelphiAppTranslation;$(DCC_UnitSearchPath)</DCC_UnitSearchPath>
    <DCC_DebugInformation>1</DCC_DebugInformation>
    <DCC_LocalDebugSymbols>true</DCC_LocalDebugSymbols>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Platform)'=='Win32'">
    <DCC_LargeAddressAware>true</DCC_LargeAddressAware>
  </PropertyGroup>
  <ItemGroup>
    <DelphiCompile Include="$(MainSource)"><MainSource>MainSource</MainSource></DelphiCompile>
    <DCCReference Include="DPH.UI.Main.pas"><Form>DPHMainForm</Form><FormType>fmx</FormType></DCCReference>
    <DCCReference Include="DPH.UI.ProjectProfile.pas"><Form>DPHProjectProfileForm</Form><FormType>fmx</FormType></DCCReference>
    <DCCReference Include="DPH.Knowledge.ProjectProfile.pas" />
    <DCCReference Include="DPH.Knowledge.Glossary.pas" />
    <DCCReference Include="DPH.UI.Glossary.pas"><Form>DPHGlossaryForm</Form><FormType>fmx</FormType></DCCReference>
    <DCCReference Include="DPH.Storage.Types.pas" />
    <DCCReference Include="DPH.Storage.Database.pas" />
    <DCCReference Include="DPH.Storage.Backup.pas" />
    <DCCReference Include="DPH.Parse.Model.pas" />
    <DCCReference Include="DPH.Project.Source.pas" />
    <DCCReference Include="DPH.Parse.Lexer.pas" />
    <DCCReference Include="DPH.Parse.Preprocessor.pas" />
    <DCCReference Include="DPH.Parse.Pascal.pas" />
    <DCCReference Include="DPH.Parse.Resources.pas" />
    <DCCReference Include="DPH.Parse.Forms.pas" />
    <DCCReference Include="DPH.Project.Inventory.pas" />
    <DCCReference Include="DPH.Project.Analysis.pas" />
    <DCCReference Include="DPH.Analysis.Model.pas" />
        <DCCReference Include="DPH.Analysis.Quality.pas" />
        <DCCReference Include="DPH.Workspace.Comparison.pas" />
    <DCCReference Include="DPH.Analysis.Symbols.pas" />
    <DCCReference Include="DPH.Analysis.Flow.pas" />
    <DCCReference Include="DPH.Analysis.Async.pas" />
    <DCCReference Include="DPH.Analysis.SQL.pas" />
    <DCCReference Include="DPH.Workspace.Graphs.pas" />
    <DCCReference Include="DPH.Analysis.Persistence.pas" />
    <DCCReference Include="DPH.Workspace.Model.pas" />
    <DCCReference Include="DPH.Workspace.Catalog.pas" />
    <DCCReference Include="DPH.Workspace.Worker.pas" />
    <DCCReference Include="DPH.Workspace.Screen.pas" />
    <DCCReference Include="DPH.Publish.Model.pas" />
    <DCCReference Include="DPH.Publish.Export.pas" />
    <DCCReference Include="DPH.Publish.Translation.pas" />
    <DCCReference Include="DPH.Publish.BrowserPolicy.pas" />
    <BuildConfiguration Include="Debug"><Key>Cfg_1</Key><CfgParent>Base</CfgParent></BuildConfiguration>
    <BuildConfiguration Include="Release"><Key>Cfg_2</Key><CfgParent>Base</CfgParent></BuildConfiguration>
  </ItemGroup>
  <Import Project="$(BDS)\Bin\CodeGear.Delphi.Targets" />
</Project>
