object DPHActionPurposeForm: TDPHActionPurposeForm
  Caption = 'Action and business purpose record'
  ClientWidth = 820
  ClientHeight = 740
  Constraints.MinWidth = 620
  Constraints.MinHeight = 480
  Position = ScreenCenter
  object ProfilePurpose: TLabel
    Align = Top
    Height = 100
    Margins.Left = 12
    Margins.Right = 12
    WordWrap = True
    Text = 'Document the action or task name, business purpose, steps, expected outcome and evidence with a named contributor. Apply prepares a Knowledge draft; click Save there, then review explicitly. Unknown permissions and outcomes must remain explicit. Do not enter credentials.'
    StyledSettings = []
    TextSettings.Font.Size = 16
    TextSettings.FontColor = xFF146CB4
  end
  object ProfileToolbar: TLayout
    Align = Top
    Height = 92
    object ProfileAuthorLabel: TLabel
      Position.X = 12
      Position.Y = 0
      Width = 180
      Height = 24
      Text = 'Named contributor'
    end
    object ProfileAuthorEdit: TEdit
      Position.X = 12
      Position.Y = 26
      Width = 270
      Height = 30
    end
    object ApplyProfileButton: TButton
      Position.X = 292
      Position.Y = 26
      Width = 210
      Height = 30
      Text = 'Apply to Knowledge draft'
      OnClick = ApplyProfileClick
    end
    object CancelProfileButton: TButton
      Position.X = 512
      Position.Y = 26
      Width = 86
      Height = 30
      Text = 'Cancel'
      ModalResult = 2
    end
  end
