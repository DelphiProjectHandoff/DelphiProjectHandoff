object DPHProjectProfileForm: TDPHProjectProfileForm
  Caption = 'Describe the application'
  ClientWidth = 820
  ClientHeight = 740
  Constraints.MinWidth = 620
  Constraints.MinHeight = 480
  Position = ScreenCenter
  object ProfilePurpose: TLabel
    Align = Top
    Height = 100
    Margins.Left = 12
    Margins.Right = 12
    WordWrap = True
    Text = 'Explain the selected application for a new learner: its purpose, who can help, where practice is safe and how its main parts fit together. Purpose and attribution are required. Apply prepares a draft; click Save in Saved explanations to keep it. Leave unanswered fields Unknown.'
    StyledSettings = []
    TextSettings.Font.Size = 16
    TextSettings.FontColor = xFF146CB4
  end
