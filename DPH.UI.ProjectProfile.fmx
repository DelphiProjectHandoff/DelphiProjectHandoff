object DPHProjectProfileForm: TDPHProjectProfileForm
  Caption = 'Selected application profile'
  ClientWidth = 820
  ClientHeight = 740
  Constraints.MinWidth = 620
  Constraints.MinHeight = 480
  Position = ScreenCenter
  object ProfilePurpose: TLabel
    Align = Top
    Height = 100
    Margins.Left = 12
    Margins.Right = 12
    WordWrap = True
    Text = 'Describe only the selected application. Purpose and attribution are required. Blank optional fields stay explicitly unknown. Apply creates a Knowledge draft; use Save there, then review with a named reviewer. Do not enter credentials.'
    StyledSettings = []
    TextSettings.Font.Size = 16
    TextSettings.FontColor = xFF146CB4
  end
  object ProfileToolbar: TLayout
    Align = Top
    Height = 92
    object ProfileAuthorLabel: TLabel
      Position.X = 12
      Position.Y = 0
      Width = 180
      Height = 24
      Text = 'Named contributor'
    end
    object ProfileAuthorEdit: TEdit
      Position.X = 12
      Position.Y = 26
      Width = 270
      Height = 30
    end
    object ApplyProfileButton: TButton
      Position.X = 292
      Position.Y = 26
      Width = 210
      Height = 30
      Text = 'Apply to Knowledge draft'
      OnClick = ApplyProfileClick
    end
    object CancelProfileButton: TButton
      Position.X = 512
      Position.Y = 26
      Width = 86
      Height = 30
      Text = 'Cancel'
      ModalResult = 2
    end
  end
  object ProfileScroll: TVertScrollBox
