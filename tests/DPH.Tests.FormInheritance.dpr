program DPHFormInheritanceTests;
{$APPTYPE CONSOLE}
uses System.SysUtils,System.Classes,System.IOUtils,System.JSON,System.Hash,System.Types,System.UITypes,
 FMX.Forms,FMX.Types,FMX.Graphics,DPH.Project.Analysis,DPH.Analysis.Symbols,DPH.Analysis.Model,
 DPH.Workspace.Model,DPH.Workspace.FormInheritance,DPH.Workspace.Keyboard,DPH.UI.Main,DPH.Workspace.Catalog;
var Root,Fixture,Text,BeforeHash,Catalog,CatalogHash,OriginalDerived:string;Checks,I:Integer;
 Analyzer:TDPHAnalyzer;Semantic:TDPHSemanticAnalyzer;Scan:TDPHScan;Graph:TDPHSemanticGraph;
 View,Cached:TDPHWorkspaceView;Report,Other,Row,Prop,Origin,Doc:TJSONObject;V:TJSONValue;
 Form:TDPHMainForm;Input:TStringStream;Binary:TMemoryStream;Rejected:Boolean;Bitmap:TBitmap;
procedure Check(OK:Boolean;const S:string);
begin if not OK then raise Exception.Create('FAIL '+S);Inc(Checks);Writeln('PASS ',Checks,': ',S);Flush(Output);end;
procedure Write(const Name,Content:string);
begin TFile.WriteAllText(TPath.Combine(Fixture,Name),Content.Replace('|',sLineBreak),TEncoding.UTF8);end;
procedure UnitForm(const Name,ClassName,Base,Content:string;const Ext:string='.dfm');
begin Write(Name+'.pas','unit '+Name+'; interface uses Base, Mid, FrameUnit; type '+ClassName+' = class('+Base+') end; implementation {$R *'+Ext+'} end.');Write(Name+Ext,Content);end;
function Find(const Source,Path:string):TJSONObject;
var V:TJSONValue;
begin Result:=nil;for V in Report.GetValue<TJSONArray>('rows') do if SameText(V.GetValue<string>('form_source'),Source) and (V.GetValue<string>('component_path')=Path) then Exit(V as TJSONObject);end;
function PropertyOf(R:TJSONObject;const Name:string):TJSONObject;
var V:TJSONValue;
begin Result:=nil;if R=nil then Exit;for V in R.GetValue<TJSONArray>('properties') do if SameText(V.GetValue<string>('name'),Name) then Exit(V as TJSONObject);end;
procedure Render(const Name:string);
begin Application.ProcessMessages;Bitmap:=TBitmap.Create(Form.ClientWidth,Form.ClientHeight);try if Bitmap.Canvas.BeginScene then try Form.PaintTo(Bitmap.Canvas);finally Bitmap.Canvas.EndScene;end;Bitmap.SaveToFile(TPath.Combine(Root,'docs\'+Name));finally Bitmap.Free;end;end;
begin
 Application.Initialize;
 try
 Root:=TPath.GetFullPath(ParamStr(1));Fixture:=TPath.Combine(Root,'bin\form-inheritance-validation\source');TDirectory.CreateDirectory(Fixture);
 Write('Inheritance.dpr','program Inheritance; uses Base, Mid, Derived, FrameUnit, FrameDerived, Touch, BinaryForm, Missing, DupA, DupB, Ambiguous, CycleA, CycleB, Orphan; begin end.');
 UnitForm('Base','TBase','TForm','object BaseForm: TBase| Caption = ''Base title''| object Panel: TPanel|  Width = 400|  object Button: TButton|   Caption = ''Base button''|   OnClick = BaseClick|   Visible = True|  end| end| object Untouched: TLabel|  Caption = ''Inherited label''| end|end');
 UnitForm('Mid','TMid','TBase','inherited MidForm: TMid| Caption = ''Mid title''| inherited Panel: TPanel|  inherited Button: TButton|   Caption = ''Mid button''|  end| end|end');
 UnitForm('FrameUnit','TEmbedded','TFrame','object Embedded: TEmbedded| Width = 120| object Field: TEdit|  Text = ''Frame text''|  OnChange = FrameChange| end|end');
 UnitForm('FrameDerived','TFrameDerived','TEmbedded','inherited Specialized: TFrameDerived| inherited Field: TEdit|  Text = ''Specialized text''| end|end');
 UnitForm('Derived','TDerived','TMid','inherited DerivedForm: TDerived| inherited Panel: TPanel|  inherited Button: TButton|   Caption = ''Final button''|   OnClick = nil|  end| end| inline LeftFrame: TEmbedded|  inherited Field: TEdit|   Text = ''Instance text''|  end| end| inline RightFrame: TEmbedded| end|end');
 UnitForm('Touch','TTouch','TForm','object Touch: TTouch| inline TouchFrame: TEmbedded| end| inline SpecializedFrame: TFrameDerived| end| inline Qualified: DupA.TDuplicate| end|end','.fmx');
 UnitForm('BinaryForm','TBinaryForm','TBase','inherited BinaryRoot: TBinaryForm| inherited Panel: TPanel|  Width = 500| end|end');
 Input:=TStringStream.Create(TFile.ReadAllText(TPath.Combine(Fixture,'BinaryForm.dfm')));Binary:=TMemoryStream.Create;try ObjectTextToBinary(Input,Binary);Binary.SaveToFile(TPath.Combine(Fixture,'BinaryForm.dfm'));finally Binary.Free;Input.Free;end;
 UnitForm('Missing','TMissing','TNotCaptured','inherited MissingRoot: TMissing| Caption = ''Local only''| inline MissingFrame: TAbsent| end|end');
 UnitForm('DupA','TDuplicate','TForm','object DupA: TDuplicate| Caption = ''A''|end');UnitForm('DupB','TDuplicate','TForm','object DupB: TDuplicate| Caption = ''B''|end');
 UnitForm('Ambiguous','TAmbiguous','TForm','object Ambiguous: TAmbiguous| inline Choice: TDuplicate| end|end');
 UnitForm('CycleA','TCycleA','TFrame','object A: TCycleA| inline B: TCycleB| end|end');UnitForm('CycleB','TCycleB','TFrame','object B: TCycleB| inline A: TCycleA| end|end');
 Text:='inherited OrphanRoot: TOrphan| inherited Unknown: TButton|  Caption = ''Orphan''| end| inherited Panel: TEdit|  Text = ''Incompatible''| end|';
 for I:=1 to 270 do Text:=Text+' object Extra'+IntToStr(I)+': TLabel| end|';
 UnitForm('Orphan','TOrphan','TBase',Text+'end');BeforeHash:=THashSHA2.GetHashStringFromFile(TPath.Combine(Fixture,'Derived.dfm'));
 Analyzer:=TDPHAnalyzer.Create;Semantic:=TDPHSemanticAnalyzer.Create;
 try Scan:=Analyzer.Scan(TPath.Combine(Fixture,'Inheritance.dpr'),'Debug','Win32',[],[],False);try Graph:=Semantic.Analyze(Scan);try View:=TDPHWorkspaceView.Create(TDPHWorkspaceView.Capture(Scan,Graph,7,'Inheritance.dpr','Debug','Win32',[],[]));finally Graph.Free;end;finally Scan.Free;end;finally Semantic.Free;Analyzer.Free;end;
 try Report:=TDPHFormInheritance.Inspect(View);try
 Check(Find('Derived.dfm','/DerivedForm/Panel/Button')<>nil,'Inherited component path resolves through renamed multi-level roots');
 Row:=Find('Derived.dfm','/DerivedForm/Panel/Button');Prop:=PropertyOf(Row,'Caption');Check(Prop.GetValue<string>('value')='''Final button''','Derived value overrides inherited value');
 Check(Prop.GetValue<TJSONArray>('history').Count=3,'All three base-to-derived values retained');
 Check(Prop.GetValue<TJSONArray>('history').Items[0].GetValue<string>('source')='base.dfm','First value cites base form');Check(Prop.GetValue<TJSONArray>('history').Items[1].GetValue<string>('source')='mid.dfm','Middle value cites intermediate form');
 Check(Row.GetValue<TJSONArray>('declarations').Count=3,'Component declaration chain retained');
 Check(PropertyOf(Row,'Visible').GetValue<string>('value')='True','Unchanged base property survives');
 Prop:=PropertyOf(Row,'OnClick');Check((Prop.GetValue<string>('value')='nil') and (Prop.GetValue<TJSONArray>('history').Count=2),'Explicit nil overrides inherited event without inventing dispatch');
 Check(PropertyOf(Find('Derived.dfm','/DerivedForm/Untouched'),'Caption').GetValue<string>('value')='''Inherited label''','Base-only components remain visible');
 Check(PropertyOf(Find('Derived.dfm','/DerivedForm'),'Caption').GetValue<string>('value')='''Mid title''','Root property inherited across root renaming');
 Row:=Find('Derived.dfm','/DerivedForm/LeftFrame/Field');Check(Row<>nil,'Inline frame children expanded');Check(PropertyOf(Row,'Text').GetValue<string>('value')='''Instance text''','Instance overlay overrides embedded frame');
 Check(PropertyOf(Row,'Text').GetValue<TJSONArray>('history').Count=2,'Frame and instance property origins retained');Check(PropertyOf(Row,'OnChange').GetValue<string>('value')='FrameChange','Inherited frame event survives');
 Check(PropertyOf(Find('Derived.dfm','/DerivedForm/RightFrame/Field'),'Text').GetValue<string>('value')='''Frame text''','Separate frame instances do not leak overrides');
 Check(Find('Touch.fmx','/Touch/TouchFrame/Field')<>nil,'FMX inline frame expansion supported');
 Check(PropertyOf(Find('Touch.fmx','/Touch/SpecializedFrame/Field'),'Text').GetValue<string>('value')='''Specialized text''','Inherited frame resolves before embedding');
 Check(PropertyOf(Find('Touch.fmx','/Touch/SpecializedFrame/Field'),'Text').GetValue<TJSONArray>('history').Count=2,'Inherited frame property keeps both source origins');
 Check(PropertyOf(Find('Touch.fmx','/Touch/Qualified'),'Caption').GetValue<string>('value')='''A''','Qualified frame class disambiguates duplicate simple names');
 Check(PropertyOf(Find('BinaryForm.dfm','/BinaryRoot/Panel'),'Width').GetValue<string>('value')='500','Binary DFM inherited overlay supported');
 Check(Find('Missing.dfm','/MissingRoot').GetValue<TJSONArray>('diagnostics').ToJSON.Contains('Missing captured'),'Uncaptured ancestor reported');
 Check(Find('Missing.dfm','/MissingRoot/MissingFrame')<>nil,'Unresolved inline declaration remains inspectable');
 Check(Find('Ambiguous.dfm','/Ambiguous/Choice').GetValue<TJSONArray>('diagnostics').ToJSON.Contains('Ambiguous captured'),'Ambiguous frame remains unresolved');
 Check(Find('CycleA.dfm','/A').GetValue<TJSONArray>('diagnostics').ToJSON.Contains('Cycle'),'Recursive frame cycle stops with diagnostic');
 Check(Find('Orphan.dfm','/OrphanRoot').GetValue<TJSONArray>('diagnostics').ToJSON.Contains('Unresolved component overlay'),'Orphan/incompatible overlay reported');
 Origin:=Prop.GetValue<TJSONArray>('history').Items[0] as TJSONObject;Check(Origin.GetValue<string>('source_hash')<>'','Property provenance fingerprints retained');Check(Origin.GetValue<Integer>('range.line')>0,'Exact text line retained');Check(Origin.GetValue<Int64>('generation_id')=7,'Generation retained for each origin');
 Check(TDPHKeyboardInspector.ReadSource(View,TPath.Combine(Fixture,'Inheritance.dpr'),Origin,Origin.GetValue<TJSONObject>('range')).Contains('BaseClick'),'Inherited source navigation reads actual base source');
 Row:=Find('BinaryForm.dfm','/BinaryRoot/Panel');Origin:=PropertyOf(Row,'Width').GetValue<TJSONArray>('history').Items[1] as TJSONObject;Rejected:=False;try TDPHKeyboardInspector.ReadSource(View,TPath.Combine(Fixture,'Inheritance.dpr'),Origin,Origin.GetValue<TJSONObject>('range'));except Rejected:=True;end;Check(Rejected,'Binary property origin refuses text navigation');
 Row:=Find('Derived.dfm','/DerivedForm/Panel/Button');Origin:=PropertyOf(Row,'Caption').GetValue<TJSONArray>('history').Items[2] as TJSONObject;
 OriginalDerived:=TFile.ReadAllText(TPath.Combine(Fixture,'Derived.dfm'));TFile.AppendAllText(TPath.Combine(Fixture,'Derived.dfm'),sLineBreak,TEncoding.UTF8);Rejected:=False;try TDPHKeyboardInspector.ReadSource(View,TPath.Combine(Fixture,'Inheritance.dpr'),Origin,Origin.GetValue<TJSONObject>('range'));except Rejected:=True;end;Check(Rejected,'Changed origin source refuses captured range');TFile.WriteAllText(TPath.Combine(Fixture,'Derived.dfm'),OriginalDerived,TEncoding.UTF8);
 Check(THashSHA2.GetHashStringFromFile(TPath.Combine(Fixture,'Derived.dfm'))=BeforeHash,'Source restored byte for byte after mutation check');
 Rejected:=False;try TDPHKeyboardInspector.ReadSource(View,'',Origin,Origin.GetValue<TJSONObject>('range'));except Rejected:=True;end;Check(Rejected,'Detached source refused');
 Cached:=TDPHWorkspaceView.Create(TJSONObject.ParseJSONValue(View.Document.ToJSON) as TJSONObject);try Other:=TDPHFormInheritance.Inspect(Cached);try Check(Other.ToJSON=Report.ToJSON,'Fresh and serialized cache produce identical overlays');finally Other.Free;end;finally Cached.Free;end;
 Doc:=View.Document.Clone as TJSONObject;
 for V in Doc.GetValue<TJSONArray>('semantics.relationships') do if (V.GetValue<string>('kind')='inherits') and (V.GetValue<string>('label')='TMid') then begin (V as TJSONObject).RemovePair('condition').Free;(V as TJSONObject).AddPair('condition','UNKNOWN_DEFINE');end;
 Cached:=TDPHWorkspaceView.Create(Doc);try Other:=TDPHFormInheritance.Inspect(Cached);try Check(Other.ToJSON.Contains('Conditional ancestor remains unresolved'),'Conditional base is not silently selected');finally Other.Free;end;finally Cached.Free;end;
 Check(TDPHFormInheritance.Describe(Row).Contains('BaseClick'),'Readable history exposes replaced event');Check(Report.GetValue<string>('qualification').Contains('No target classes'),'Target instantiation explicitly excluded');
 Catalog:=TDPHWorkspaceCatalog.DefaultPath;CatalogHash:='';if TFile.Exists(Catalog) then CatalogHash:=THashSHA2.GetHashStringFromFile(Catalog);
 Form:=TDPHMainForm.Create(nil);try Form.PollTimer.Enabled:=False;Form.ChangeTimer.Enabled:=False;Form.LoadView(View.Document.Clone as TJSONObject);
 Check(Form.WorkspacePageCombo.Items.IndexOf('Form inheritance')>=0,'Inspector discoverable in workspace selector');Check(Form.InheritanceList.Count=250,'Native list bounds first page');Check(Form.InheritanceNextButton.Enabled,'Next page available');Form.InheritanceFilterChange(Form.InheritanceNextButton);Check(Form.InheritanceList.Count>0,'Next page exposes additional records');Form.InheritanceFilterChange(Form.InheritanceFirstButton);Check(Form.InheritanceList.Count=250,'First page resets offset');
 Form.InheritanceFilterEdit.Text:='FORM INHERITANCE /DerivedForm/Panel/Button';Form.InheritanceFilterChange(nil);Check(Form.InheritanceList.Count=1,'Filter finds specific inherited component');Check(Form.InheritanceMemo.Text.Contains('Final button') and Form.InheritanceMemo.Text.Contains('BaseClick'),'Native explanation shows effective property and inherited event history');Check(Form.InheritanceOriginCombo.Items.Count>=9,'All declaration and property origins selectable');Check(Form.InheritanceSourceButton.Enabled,'Selected origin enables source action');Form.InheritanceSourceClick(nil);Check(Form.InheritanceMemo.Text.Contains('Source is detached'),'Native detached navigation guarded');
 Form.WorkspaceTabs.ActiveTab:=Form.InheritanceTab;Form.Show;Render('phase1-form-inheritance-workspace.png');Form.WindowState:=TWindowState.wsNormal;Form.Width:=960;Form.Height:=600;Render('phase1-form-inheritance-compact.png');Check(Form.InheritanceMemo.Height>=60,'Minimum window keeps explanation usable');Check(Form.InheritanceToolbar.ShowScrollBars,'Compact origin toolbar scrolls');Form.InheritanceToolbar.ViewportPosition:=PointF(10000,0);Application.ProcessMessages;Check(Form.InheritanceSourceButton.AbsoluteRect.Right<=Form.InheritanceToolbar.AbsoluteRect.Right+2,'Origin source action reachable at minimum width');Render('phase1-form-inheritance-origins.png');Form.Hide;
 Form.InheritanceFilterEdit.Text:='xyz absent';Form.InheritanceFilterChange(nil);Check((Form.InheritanceList.Count=0) and not Form.InheritanceSourceButton.Enabled and (Form.InheritanceOriginCombo.Items.Count=0),'Empty filter clears obsolete origins');
 Doc:=View.Document.Clone as TJSONObject;Doc.GetValue<TJSONObject>('syntax').RemovePair('files').Free;Doc.GetValue<TJSONObject>('syntax').AddPair('files',TJSONArray.Create);Form.LoadView(Doc);Check(Form.InheritanceList.Count=0,'Replacement capture clears inherited rows');
 finally Form.Free;end;
 Check((not TFile.Exists(Catalog) and (CatalogHash='')) or (TFile.Exists(Catalog) and (THashSHA2.GetHashStringFromFile(Catalog)=CatalogHash)),'User catalog unchanged');Check(THashSHA2.GetHashStringFromFile(TPath.Combine(Fixture,'Derived.dfm'))=BeforeHash,'Selected fixture source unchanged');
 TFile.WriteAllText(TPath.Combine(Root,'docs\phase1-form-inheritance-validation.json'),TJSONObject.Create.AddPair('result','PASS').AddPair('checks',TJSONNumber.Create(Checks)).AddPair('qualification','Actual text/binary DFM and FMX parsing, cached overlays and native DPH controls. No target classes instantiated. PaintTo renders are not target-runtime screenshots.').ToJSON,TEncoding.UTF8);
 finally Report.Free;end;finally View.Free;end;
 except on E:Exception do begin Writeln(E.ClassName,': ',E.Message);ExitCode:=1;end;end;
end.
