program DPH.Tests.BusinessProcess;
{$APPTYPE CONSOLE}
uses System.Types,System.SysUtils,System.Classes,System.IOUtils,System.JSON,System.Hash,System.StrUtils,System.UITypes,
 FMX.Forms,FMX.Graphics,DPH.Project.Analysis,DPH.Analysis.Model,DPH.Analysis.Symbols,
 DPH.Workspace.Model,DPH.UI.Main,DPH.Storage.Database,DPH.Analysis.Persistence,DPH.Workspace.Catalog,DPH.Publish.Model,DPH.Publish.Export;
var Root,Work,Fixture,Body,Metadata,ProcessTitle,SourceHash,Catalog,CatalogHash,Before,DatabaseName:string;
 I,Checks:Integer;Config,Generation,ProcessID,Revision,OldRevision,ProcedureID:Int64;
 Analyzer:TDPHAnalyzer;Semantic:TDPHSemanticAnalyzer;Scan:TDPHScan;Graph:TDPHSemanticGraph;
 View:TDPHWorkspaceView;Store:TDPHKnowledgeStore;Form:TDPHMainForm;Bitmap:TBitmap;Model:TDPHDocumentModel;
 Rows,Links,Policies:TJSONArray;Row,RecordValue,Log:TJSONObject;Value:TJSONValue;Denied:Boolean;
procedure Check(OK:Boolean;const MessageText:string);
begin if not OK then raise Exception.Create('FAIL '+MessageText);Inc(Checks);Writeln('PASS ',Checks,': ',MessageText);Flush(Output);end;
function LoadProcess:TJSONObject;
var A:TJSONArray;V:TJSONValue;
begin Result:=nil;A:=Store.KnowledgeJSON;try for V in A do if V.GetValue<string>('id')=IntToStr(ProcessID) then Exit(V.Clone as TJSONObject);finally A.Free;end;end;
function SaveProcess(ID,Expected:Int64;const Title,Text,Author,Kind,Document,Audience,LinkJSON,Structured:string):Boolean;
begin Result:=False;try Store.SaveKnowledge(ID,Expected,Generation,Title,Text,Author,Kind,'',Document,Audience,LinkJSON,'',Structured);except on E:Exception do Result:=True;end;end;
procedure Render(const Name:string);
begin Application.ProcessMessages;Bitmap:=TBitmap.Create(Form.ClientWidth,Form.ClientHeight);try
 if Bitmap.Canvas.BeginScene then try Form.PaintTo(Bitmap.Canvas);finally Bitmap.Canvas.EndScene;end;
 Bitmap.SaveToFile(TPath.Combine(Root,'docs\'+Name));finally Bitmap.Free;end;end;
begin
 Application.Initialize;
 try
 Root:=TPath.GetFullPath(ParamStr(1));Work:=TPath.Combine(Root,'bin\business-process-validation');Fixture:=TPath.Combine(Work,'source');TDirectory.CreateDirectory(Fixture);
 TFile.WriteAllText(TPath.Combine(Fixture,'Operations.dpr'),'program Operations; uses Main; begin end.',TEncoding.UTF8);
 TFile.WriteAllText(TPath.Combine(Fixture,'Main.pas'),'unit Main; interface implementation procedure FulfilOrders; begin end; end.',TEncoding.UTF8);
 SourceHash:=THashSHA2.GetHashStringFromFile(TPath.Combine(Fixture,'Main.pas'));
 Analyzer:=TDPHAnalyzer.Create;Semantic:=TDPHSemanticAnalyzer.Create;
 try Scan:=Analyzer.Scan(TPath.Combine(Fixture,'Operations.dpr'),'Debug','Win32',[],[],False);
 try Graph:=Semantic.Analyze(Scan);
 try Store:=TDPHKnowledgeStore.Create(TPath.Combine(Work,'process-'+TGUID.NewGuid.ToString+'.dphdb'),Fixture,TPath.Combine(Root,'migrations'));
 try Store.InitializeProject('Controlled target recovery requirements','Delphi');Config:=Store.AddConfiguration('Win32','37.0','[]','[]','Debug');Store.SelectConfiguration(Config);
 Generation:=TDPHSemanticPersistence.Stage(Scan,Graph,Store,Config);View:=TDPHWorkspaceView.Create(TDPHWorkspaceView.Capture(Scan,Graph,Generation,'Operations.dpr','Debug','Win32',[],[]));
 try Store.SaveWorkspaceView(Generation,View.Document.ToJSON);TDPHSemanticPersistence.Publish(Scan,Graph,Store,Generation);Before:=View.Document.ToJSON;
 RecordValue:=TDPHWorkspaceView.NewBusinessProcess;
 try
  Row:=RecordValue.GetValue<TJSONObject>('fields');
  Row.RemovePair('name').Free;Row.AddPair('name','Fulfil orders');
  Row.RemovePair('owner').Free;Row.AddPair('owner','Operations manager');
  Row.RemovePair('inputs').Free;Row.AddPair('inputs','Approved order from sales');
  Row.RemovePair('outputs').Free;Row.AddPair('outputs','Dispatch confirmation to customer');
  Row.RemovePair('steps').Free;Row.AddPair('steps','1. Check order; 2. Reserve stock; 3. Dispatch; 4. Confirm');
  TDPHWorkspaceView.ValidateBusinessProcess(RecordValue);Metadata:=RecordValue.ToJSON;
  Body:=TDPHWorkspaceView.BusinessProcessBody(RecordValue);ProcessTitle:='Fulfil orders';
  Check(Body.Contains('Approved order from sales'),'Structured process inputs rendered');
  Check(Body.Contains('Dispatch confirmation to customer'),'Structured process outputs rendered');
  Check(Body.Contains('Operations manager'),'Accountable owner rendered separately from contributor');
  Check(Body.Contains('Ordered steps and handoffs'),'Structured ordered steps rendered');
  Check(Body.Contains('Department and participating roles: Unknown'),'Missing department remains explicitly unknown');
  Check(Body.Contains('not observed execution'),'Business process qualification retained');
 finally RecordValue.Free;end;
 Check(SaveProcess(0,0,ProcessTitle,Body,'','business_rule','maintenance','maintainer','',Metadata),'Anonymous process author rejected');
 Check(SaveProcess(0,0,'Incorrect title',Body,'Author','business_rule','maintenance','maintainer','',Metadata),'Placeholder title rejected');
 Check(SaveProcess(0,0,ProcessTitle,'Process heading removed','Author','business_rule','maintenance','maintainer','',Metadata),'Removed process heading rejected');
 Check(SaveProcess(0,0,ProcessTitle,Body,'Author','engineering_rule','maintenance','maintainer','',Metadata),'Incorrect process kind rejected');
 Check(SaveProcess(0,0,ProcessTitle,Body,'Author','business_rule','user','user','',Metadata),'Incorrect process audience rejected');
 RecordValue:=TJSONObject.ParseJSONValue(Metadata) as TJSONObject;try RecordValue.RemovePair('process_id').Free;RecordValue.AddPair('process_id','invalid');Check(SaveProcess(0,0,ProcessTitle,Body,'Author','business_rule','maintenance','maintainer','',RecordValue.ToJSON),'Invalid stable process identity rejected');finally RecordValue.Free;end;
 RecordValue:=TJSONObject.ParseJSONValue(Metadata) as TJSONObject;try RecordValue.AddPair('unexpected','x');Check(SaveProcess(0,0,ProcessTitle,Body,'Author','business_rule','maintenance','maintainer','',RecordValue.ToJSON),'Unknown process metadata rejected');finally RecordValue.Free;end;
 RecordValue:=TJSONObject.ParseJSONValue(Metadata) as TJSONObject;try Row:=RecordValue.GetValue<TJSONObject>('fields');Row.RemovePair('inputs').Free;Row.AddPair('inputs','');Check(SaveProcess(0,0,ProcessTitle,Body,'Author','business_rule','maintenance','maintainer','',RecordValue.ToJSON),'Empty structured inputs rejected; Unknown must be explicit');finally RecordValue.Free;end;
 RecordValue:=TJSONObject.ParseJSONValue(Metadata) as TJSONObject;try Row:=RecordValue.GetValue<TJSONObject>('fields');Row.RemovePair('owner').Free;Row.AddPair('owner',TJSONNumber.Create(1));Check(SaveProcess(0,0,ProcessTitle,Body,'Author','business_rule','maintenance','maintainer','',RecordValue.ToJSON),'Numeric owner rejected');finally RecordValue.Free;end;
 RecordValue:=TJSONObject.ParseJSONValue(Metadata) as TJSONObject;try Row:=RecordValue.GetValue<TJSONObject>('fields');Row.RemovePair('steps').Free;Row.AddPair('steps',StringOfChar('x',4097));Check(SaveProcess(0,0,ProcessTitle,Body,'Author','business_rule','maintenance','maintainer','',RecordValue.ToJSON),'Oversized structured field rejected');finally RecordValue.Free;end;
 RecordValue:=TJSONObject.ParseJSONValue(Metadata) as TJSONObject;try RecordValue.RemovePair('process_id').Free;RecordValue.AddPair('process_id',StringToGUID('{ABCDEFAB-1234-1234-1234-ABCDEFABCDEF}').ToString.ToLower);Check(SaveProcess(0,0,ProcessTitle,Body,'Author','business_rule','maintenance','maintainer','',RecordValue.ToJSON),'Noncanonical GUID spelling rejected to prevent duplicate identities');finally RecordValue.Free;end;
 Links:=TJSONArray.Create;
 try Rows:=Store.LinkCandidates(Generation,'entity','FulfilOrders');try
 Row:=nil;for Value in Rows do if View.Symbol(Value.GetValue<string>('canonical_key'))<>nil then begin Row:=Value.Clone as TJSONObject;Break;end;
 Check(Row<>nil,'Actual captured semantic implementation routine available');Row.AddPair('link_role','depends_on');Links.AddElement(Row);finally Rows.Free;end;
 ProcedureID:=Store.SaveKnowledge(0,0,Generation,'Order fulfilment procedure','Controlled order fulfilment procedure; source evidence only. No execution.','Procedure author','maintenance','','maintenance','maintainer');
 Rows:=Store.LinkCandidates(Generation,'section','Order fulfilment procedure');try Row:=Rows.Items[0].Clone as TJSONObject;Row.AddPair('link_role','cites');Links.AddElement(Row);finally Rows.Free;end;
 ProcessID:=Store.SaveKnowledge(0,0,Generation,ProcessTitle,Body,'Process author','business_rule','','maintenance','maintainer',Links.ToJSON,'',Metadata);
 finally Links.Free;end;
 Row:=LoadProcess;try Revision:=StrToInt64(Row.GetValue<string>('revision'));
 Check(TDPHWorkspaceView.IsBusinessProcess(Row),'Typed persisted process recognized');Check(Row.GetValue<string>('owner')='Process author','Named contributor persists');Check(Row.GetValue<string>('state')='needs_review','Saved process remains pending review');
 Check(Row.GetValue<TJSONArray>('rich_links').Count=2,'Routine and exact procedure-revision links persist');
 Check(Row.GetValue<string>('body').Contains('Approved order from sales'),'Structured process inputs persist');Check(Row.GetValue<string>('body').Contains('Unknown'),'Unresolved fields stay explicit');
 Check(TDPHWorkspaceView.DescribeBusinessProcess(Row).Contains('Explicit implementation/evidence links: 2'),'Inspector distinguishes resolved link count');
 finally Row.Free;end;
 Check(SaveProcess(0,0,ProcessTitle,Body,'Author','business_rule','maintenance','maintainer','',Metadata),'Duplicate process identity rejected');
 Check(SaveProcess(ProcessID,Revision,ProcessTitle,Body,'Author','business_rule','maintenance','maintainer','','{}'),'Typed metadata cannot be discarded');
 RecordValue:=TJSONObject.ParseJSONValue(Metadata) as TJSONObject;RecordValue.RemovePair('process_id').Free;RecordValue.AddPair('process_id',TGUID.NewGuid.ToString);try Check(SaveProcess(ProcessID,Revision,ProcessTitle,Body,'Author','business_rule','maintenance','maintainer','',RecordValue.ToJSON),'Saved process identity cannot change');finally RecordValue.Free;end;
 Denied:=False;try Store.ReviewKnowledge(ProcessID,Revision,Generation,'','verified');except Denied:=True;end;Check(Denied,'Anonymous process review rejected');
 OldRevision:=Revision;Store.ReviewKnowledge(ProcessID,Revision,Generation,'Process reviewer','verified');Row:=LoadProcess;try Revision:=StrToInt64(Row.GetValue<string>('revision'));Check(Row.GetValue<string>('reviewer')='Process reviewer','Named reviewer persists');Check(Row.GetValue<TJSONArray>('history').Count=2,'Review appends immutable history');Check(Row.GetValue<TJSONArray>('rich_links').Count=2,'Review retains exact implementation links');finally Row.Free;end;
 Check(SaveProcess(ProcessID,OldRevision,ProcessTitle,Body,'Editor','business_rule','maintenance','maintainer','',Metadata),'Stale process edit rejected');
 RecordValue:=TJSONObject.ParseJSONValue(Metadata) as TJSONObject;
 try
  Row:=RecordValue.GetValue<TJSONObject>('fields');Row.RemovePair('outputs').Free;Row.AddPair('outputs','Dispatch confirmation and tracking number');
  Metadata:=RecordValue.ToJSON;Body:=TDPHWorkspaceView.BusinessProcessBody(RecordValue);
 finally RecordValue.Free;end;
 Store.SaveKnowledge(ProcessID,Revision,Generation,ProcessTitle,Body,'Second author','business_rule','','maintenance','maintainer','','',Metadata);
 Row:=LoadProcess;try Check(Row.GetValue<string>('state')='needs_review','Process edits reopen review');Check(Row.GetValue<TJSONArray>('history').Count=3,'Prior reviewed process retained');Check(Row.GetValue<TJSONArray>('rich_links').Count=2,'Process revision preserves implementation links');Check(Row.GetValue<string>('body').Contains('tracking number'),'Changed structured output persists');finally Row.Free;end;
 Row:=LoadProcess;try Revision:=StrToInt64(Row.GetValue<string>('revision'));finally Row.Free;end;
 Check(SaveProcess(ProcessID,Revision,ProcessTitle,Body+sLineBreak+'invented prose','Editor','business_rule','maintenance','maintainer','',Metadata),'Structured process body cannot diverge from fields');
 Check(Store.IntegrityCheck='ok','Process database integrity valid');
 Rows:=Store.KnowledgeJSON;try Model:=TDPHDocumentModel.Create(View,Rows,[],[],False,False,nil,False,'maintainer');
 try
 Check(Model.Document.ToJSON.Contains('Fulfil orders'),'Maintainer publication includes authored process');
 Check(Model.Document.ToJSON.Contains('business_process'),'Canonical handoff preserves typed process identity');
 if TDirectory.Exists(TPath.Combine(Work,'handoff')) then begin
  RecordValue:=TJSONObject.ParseJSONValue(TFile.ReadAllText(TPath.Combine(Work,'handoff\manifest.json'),TEncoding.UTF8)) as TJSONObject;
  try if RecordValue.GetValue<string>('project','')<>'Operations.dpr' then raise Exception.Create('Refusing to replace an unrelated test export');finally RecordValue.Free;end;
  TDirectory.Delete(TPath.Combine(Work,'handoff'),True);
 end;
 TDPHPublisher.Export(Model,Store,TPath.Combine(Work,'handoff'));
 TDPHPublisher.Validate(TPath.Combine(Work,'handoff'),Model.Document.GetValue<string>('input_fingerprint'));
 Check(True,'Business process handoff passes full bundle validation');
 Check(TFile.ReadAllText(TPath.Combine(Work,'handoff\index.html'),TEncoding.UTF8).Contains('Approved order from sales'),'Published HTML includes structured inputs');
 finally Model.Free;end;finally Rows.Free;end;
 DatabaseName:=Store.DatabasePath;FreeAndNil(Store);Store:=TDPHKnowledgeStore.Create(DatabaseName,Fixture,TPath.Combine(Root,'migrations'));Store.SelectConfiguration(Config);
 Row:=LoadProcess;try Check(Row<>nil,'Business process survives database close and reopen');Check(Row.GetValue<string>('structured_json')=Metadata,'Exact structured fields survive reopening');Check(Row.GetValue<TJSONArray>('history').Count=3,'Immutable review and edit history survives reopening');Check(Row.GetValue<TJSONArray>('rich_links').Count=2,'Exact source and procedure links survive reopening');finally Row.Free;end;
 Catalog:=TDPHWorkspaceCatalog.DefaultPath;CatalogHash:='';if TFile.Exists(Catalog) then CatalogHash:=THashSHA2.GetHashStringFromFile(Catalog);
 Form:=TDPHMainForm.Create(nil);
 try Form.PollTimer.Enabled:=False;Form.ChangeTimer.Enabled:=False;Form.LoadView(View.Document.Clone as TJSONObject);Form.LoadKnowledge(Store.KnowledgeJSON);
 Check(Form.BusinessProcessList.Count=1,'Native register includes process and excludes unrelated procedure');Check(Form.BusinessProcessMemo.Text.Contains('Second author'),'Native inspector shows current contributor');
 Form.PendingKnowledgeCheck.IsChecked:=True;Form.BusinessProcessOpenClick(nil);Check(Form.WorkspaceTabs.ActiveTab=Form.KnowledgeTab,'Open plan enters saved Knowledge workflow');Check(Form.KnowledgeBodyMemo.ReadOnly,'Saved structured body protected from free text edits');Check(Form.KnowledgeTitleEdit.ReadOnly,'Saved stable title protected');Check(not Form.KnowledgeKindCombo.Enabled,'Saved process kind protected');
 Form.BusinessProcessOpenClick(Form.BusinessProcessLinks);Check(Form.WorkspaceTabs.ActiveTab=Form.KnowledgeLinksTab,'Implementation links opens exact link workflow');Check(Form.KnowledgeLinksList.Count=2,'Native exact implementation links available');Form.KnowledgeLinksList.ItemIndex:=0;Form.OpenKnowledgeLinkClick(nil);Check(Form.WorkspaceTabs.ActiveTab=Form.ExplainTab,'Saved implementation routine opens captured explanation');
 Form.BusinessProcessEditClick(nil);Check(Form.WorkspaceTabs.ActiveTab=Form.BusinessProcessEditorTab,'Edit opens native structured fields');Check(Form.Process_inputs.Text='Approved order from sales','Native editor restores persisted input');Check(Form.Process_name.ReadOnly,'Saved process name remains stable');
 Form.Show;Render('phase1-business-process-editor.png');Form.WindowState:=TWindowState.wsNormal;Form.Width:=960;Form.Height:=600;Render('phase1-business-process-editor-compact.png');Check(Form.BusinessProcessEditorToolbar.ShowScrollBars,'Compact editor commands scroll horizontally');Form.BusinessProcessEditorScroll.ViewportPosition:=PointF(0,700);Render('phase1-business-process-editor-bottom.png');Check(Form.Process_unknowns.Height>50,'Unknowns field retains editable height');Form.Hide;
 Form.Process_outputs.Text:='Revised native output';Form.BusinessProcessAuthor.Text:='Native contributor';Form.BusinessProcessApplyClick(nil);Check(Form.WorkspaceTabs.ActiveTab=Form.KnowledgeTab,'Apply prepares Knowledge draft');Check(Form.KnowledgeBodyMemo.Text.Contains('Revised native output'),'Native structured edit generates canonical body');
 Body:=Form.KnowledgeBodyMemo.Text;Form.BusinessProcessOpenClick(nil);Check(Form.KnowledgeBodyMemo.Text=Body,'Unsaved structured draft protected from selection');Form.BusinessProcessNewClick(nil);Check(Form.StatusLabel.Text.Contains('Save or discard'),'Unsaved structured draft protected from replacement');Form.DiscardKnowledgeClick(nil);
 Form.BusinessProcessNewClick(nil);Check(Form.WorkspaceTabs.ActiveTab=Form.BusinessProcessEditorTab,'New process opens structured editor');Check(not Form.Process_name.ReadOnly,'New process name editable');
 Form.Process_name.Text:='Anonymous fixture';Form.BusinessProcessAuthor.Text:='';Form.BusinessProcessApplyClick(nil);Check(Form.WorkspaceTabs.ActiveTab=Form.BusinessProcessEditorTab,'Anonymous contributor keeps process in editor');
 Form.Process_name.Text:='Native process';Form.BusinessProcessAuthor.Text:='Native contributor';Form.BusinessProcessApplyClick(nil);Check(Form.KnowledgeBodyMemo.Text.Contains('BUSINESS PROCESS'),'New native process canonical body prepared');Check(Form.KnowledgeBodyMemo.ReadOnly,'Canonical draft body protected');Form.DiscardKnowledgeClick(nil);
 Form.BusinessProcessState.ItemIndex:=2;Form.BusinessProcessFilterChange(nil);Check(Form.BusinessProcessList.Count=0,'Review-state filter respects pending edit');Form.BusinessProcessState.ItemIndex:=0;Form.BusinessProcessFilter.Text:='Approved order';Form.BusinessProcessFilterChange(nil);Check(Form.BusinessProcessList.Count=1,'Process text search finds authored input');
 Form.BusinessProcessFilter.Text:='absent';Form.BusinessProcessFilterChange(nil);Check(Form.BusinessProcessMemo.Text.Contains('Empty results do not prove'),'Empty register explains unresolved obligations');Check(not Form.BusinessProcessOpen.Enabled,'Empty results disable opening');
 Form.BusinessProcessFilter.Text:='';Form.BusinessProcessFilterChange(nil);Form.WorkspaceTabs.ActiveTab:=Form.BusinessProcessTab;Form.Show;Render('phase1-business-process-workspace.png');Form.WindowState:=TWindowState.wsNormal;Form.Width:=960;Form.Height:=600;Render('phase1-business-process-compact.png');Check(Form.BusinessProcessMemo.Height>=50,'Compact process detail remains readable');Check(Form.BusinessProcessToolbar.ShowScrollBars and Form.BusinessProcessMemo.ShowScrollBars,'Compact commands and long policies scroll');Form.Hide;
 Policies:=TJSONArray.Create;Row:=LoadProcess;try for I:=1 to 270 do begin RecordValue:=Row.Clone as TJSONObject;Policies.AddElement(RecordValue);end;finally Row.Free;end;Form.LoadKnowledge(Policies);Check(Form.BusinessProcessList.Count=250,'Large register first page bounded');Check(Form.BusinessProcessNext.Enabled,'Large register next page accessible');Form.BusinessProcessFilterChange(Form.BusinessProcessNext);Check(Form.BusinessProcessList.Count=20,'Remaining process rows accessible');
 Form.LoadKnowledge(nil);Check(Form.BusinessProcessList.Count=0,'Clearing loaded knowledge removes prior process rows');
 finally Form.Free;end;
 Form:=TDPHMainForm.Create(nil);try Form.PollTimer.Enabled:=False;Form.ChangeTimer.Enabled:=False;Check(not Form.BusinessProcessNew.Enabled,'No capture disables new process');finally Form.Free;end;
 Check(View.Document.ToJSON=Before,'Process workflow leaves captured workspace unchanged');Check(THashSHA2.GetHashStringFromFile(TPath.Combine(Fixture,'Main.pas'))=SourceHash,'Target source unchanged');Check((not TFile.Exists(Catalog) and (CatalogHash='')) or (TFile.Exists(Catalog) and (THashSHA2.GetHashStringFromFile(Catalog)=CatalogHash)),'Owner catalog unchanged');
 Log:=TJSONObject.Create.AddPair('result','PASS').AddPair('checks',TJSONNumber.Create(Checks)).AddPair('qualification','Structured attributed business-process inventory with inputs, outputs, owners, ordered steps and exact source/procedure links. Target execution and business outcomes remain unverified.');try TFile.WriteAllText(TPath.Combine(Root,'docs\phase1-business-process-validation.json'),Log.Format,TEncoding.UTF8);finally Log.Free;end;
 finally View.Free;end;finally Store.Free;end;finally Graph.Free;end;finally Scan.Free;end;finally Semantic.Free;Analyzer.Free;end;
 except on E:Exception do begin Writeln(E.ClassName,': ',E.Message);ExitCode:=1;end;end;
end.
