 Rows:=Store.LinkCandidates(Generation,'section','Order fulfilment procedure');try Row:=Rows.Items[0].Clone as TJSONObject;Row.AddPair('link_role','cites');Links.AddElement(Row);finally Rows.Free;end;
 CalculationID:=Store.SaveKnowledge(0,0,Generation,CalculationTitle,Body,'Calculation author','business_rule','','maintenance','maintainer',Links.ToJSON,'',Metadata);
 finally Links.Free;end;
 Row:=LoadCalculation;try Revision:=StrToInt64(Row.GetValue<string>('revision'));
 Check(TDPHWorkspaceView.IsCalculation(Row),'Typed persisted calculation recognized');Check(Row.GetValue<string>('owner')='Calculation author','Named contributor persists');Check(Row.GetValue<string>('state')='needs_review','Saved calculation remains pending review');
 Check(Row.GetValue<TJSONArray>('rich_links').Count=2,'Routine and exact procedure-revision links persist');
