  Check(Body.Contains('Operations manager'),'Accountable owner rendered separately from contributor');
  Check(Body.Contains('Subtotal * (1 + TaxRate)'),'Structured formula rendered');
  Check(Body.Contains('Exceptions and boundary conditions: Unknown'),'Missing department remains explicitly unknown');
  Check(Body.Contains('not observed execution'),'Business calculation qualification retained');
