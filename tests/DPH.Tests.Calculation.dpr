 RecordValue:=TJSONObject.ParseJSONValue(Metadata) as TJSONObject;try RecordValue.AddPair('unexpected','x');Check(SaveCalculation(0,0,CalculationTitle,Body,'Author','business_rule','maintenance','maintainer','',RecordValue.ToJSON),'Unknown calculation metadata rejected');finally RecordValue.Free;end;
 RecordValue:=TJSONObject.ParseJSONValue(Metadata) as TJSONObject;try Row:=RecordValue.GetValue<TJSONObject>('fields');Row.RemovePair('inputs').Free;Row.AddPair('inputs','');Check(SaveCalculation(0,0,CalculationTitle,Body,'Author','business_rule','maintenance','maintainer','',RecordValue.ToJSON),'Empty structured inputs rejected; Unknown must be explicit');finally RecordValue.Free;end;
 RecordValue:=TJSONObject.ParseJSONValue(Metadata) as TJSONObject;try Row:=RecordValue.GetValue<TJSONObject>('fields');Row.RemovePair('owner').Free;Row.AddPair('owner',TJSONNumber.Create(1));Check(SaveCalculation(0,0,CalculationTitle,Body,'Author','business_rule','maintenance','maintainer','',RecordValue.ToJSON),'Numeric owner rejected');finally RecordValue.Free;end;
 RecordValue:=TJSONObject.ParseJSONValue(Metadata) as TJSONObject;try Row:=RecordValue.GetValue<TJSONObject>('fields');Row.RemovePair('formula').Free;Row.AddPair('formula',StringOfChar('x',4097));Check(SaveCalculation(0,0,CalculationTitle,Body,'Author','business_rule','maintenance','maintainer','',RecordValue.ToJSON),'Oversized structured field rejected');finally RecordValue.Free;end;
 RecordValue:=TJSONObject.ParseJSONValue(Metadata) as TJSONObject;try RecordValue.RemovePair('calculation_id').Free;RecordValue.AddPair('calculation_id',StringToGUID('{ABCDEFAB-1234-1234-1234-ABCDEFABCDEF}').ToString.ToLower);Check(SaveCalculation(0,0,CalculationTitle,Body,'Author','business_rule','maintenance','maintainer','',RecordValue.ToJSON),'Noncanonical GUID spelling rejected to prevent duplicate identities');finally RecordValue.Free;end;
 Links:=TJSONArray.Create;
 try Rows:=Store.LinkCandidates(Generation,'entity','FulfilOrders');try
 Row:=nil;for Value in Rows do if View.Symbol(Value.GetValue<string>('canonical_key'))<>nil then begin Row:=Value.Clone as TJSONObject;Break;end;
 Check(Row<>nil,'Actual captured semantic implementation routine available');Row.AddPair('link_role','depends_on');Links.AddElement(Row);finally Rows.Free;end;
