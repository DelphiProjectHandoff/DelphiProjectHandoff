  Row.RemovePair('owner').Free;Row.AddPair('owner','Operations manager');
  Row.RemovePair('inputs').Free;Row.AddPair('inputs','Subtotal and tax rate from approved invoice');
  Row.RemovePair('outputs').Free;Row.AddPair('outputs','Invoice total with tax');
  Row.RemovePair('formula').Free;Row.AddPair('formula','Subtotal * (1 + TaxRate)');
  Row.RemovePair('meaning').Free;Row.AddPair('meaning','Calculate invoice total including tax');
  Row.RemovePair('units').Free;Row.AddPair('units','Subtotal and output: GBP; TaxRate: dimensionless fraction');
  Row.RemovePair('rounding').Free;Row.AddPair('rounding','Round once at final total to two decimal places');
