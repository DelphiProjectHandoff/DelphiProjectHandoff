 View:TDPHWorkspaceView;Store:TDPHKnowledgeStore;Form:TDPHMainForm;Bitmap:TBitmap;Model:TDPHDocumentModel;
 Rows,Links,Policies:TJSONArray;CandidateView:TDPHWorkspaceView;CandidateDoc,CandidateResult,Node:TJSONObject;Row,RecordValue,Log:TJSONObject;Value:TJSONValue;Denied:Boolean;
procedure Check(OK:Boolean;const MessageText:string);
begin if not OK then raise Exception.Create('FAIL '+MessageText);Inc(Checks);Writeln('PASS ',Checks,': ',MessageText);Flush(Output);end;
function LoadCalculation:TJSONObject;
var A:TJSONArray;V:TJSONValue;
begin Result:=nil;A:=Store.KnowledgeJSON;try for V in A do if V.GetValue<string>('id')=IntToStr(CalculationID) then Exit(V.Clone as TJSONObject);finally A.Free;end;end;
function SaveCalculation(ID,Expected:Int64;const Title,Text,Author,Kind,Document,Audience,LinkJSON,Structured:string):Boolean;
begin Result:=False;try Store.SaveKnowledge(ID,Expected,Generation,Title,Text,Author,Kind,'',Document,Audience,LinkJSON,'',Structured);except on E:Exception do Result:=True;end;end;
procedure Render(const Name:string);
begin Application.ProcessMessages;Bitmap:=TBitmap.Create(Form.ClientWidth,Form.ClientHeight);try
 if Bitmap.Canvas.BeginScene then try Form.PaintTo(Bitmap.Canvas);finally Bitmap.Canvas.EndScene;end;
 Bitmap.SaveToFile(TPath.Combine(Root,'docs\'+Name));finally Bitmap.Free;end;end;
begin
 Application.Initialize;
 try
 Root:=TPath.GetFullPath(ParamStr(1));Work:=TPath.Combine(Root,'bin\calculation-validation');Fixture:=TPath.Combine(Work,'source');TDirectory.CreateDirectory(Fixture);
 TFile.WriteAllText(TPath.Combine(Fixture,'Operations.dpr'),'program Operations; uses Main; begin end.',TEncoding.UTF8);
 TFile.WriteAllText(TPath.Combine(Fixture,'Main.pas'),'unit Main; interface implementation const AnnualHours = 52 * 40; procedure FulfilOrders; var Subtotal, TaxRate, Total: Double; Caption: string; begin Total := Subtotal * (1 + TaxRate); Total := Round(Total * 100) / 100; Caption := ''literal + secret-number''; Total := 17; end; end.',TEncoding.UTF8);
 SourceHash:=THashSHA2.GetHashStringFromFile(TPath.Combine(Fixture,'Main.pas'));
 Analyzer:=TDPHAnalyzer.Create;Semantic:=TDPHSemanticAnalyzer.Create;
 try Scan:=Analyzer.Scan(TPath.Combine(Fixture,'Operations.dpr'),'Debug','Win32',[],[],False);
 try Graph:=Semantic.Analyze(Scan);
 try Store:=TDPHKnowledgeStore.Create(TPath.Combine(Work,'calculation-'+TGUID.NewGuid.ToString+'.dphdb'),Fixture,TPath.Combine(Root,'migrations'));
 try Store.InitializeProject('Controlled target recovery requirements','Delphi');Config:=Store.AddConfiguration('Win32','37.0','[]','[]','Debug');Store.SelectConfiguration(Config);
 Generation:=TDPHSemanticPersistence.Stage(Scan,Graph,Store,Config);View:=TDPHWorkspaceView.Create(TDPHWorkspaceView.Capture(Scan,Graph,Generation,'Operations.dpr','Debug','Win32',[],[]));
 try Store.SaveWorkspaceView(Generation,View.Document.ToJSON);TDPHSemanticPersistence.Publish(Scan,Graph,Store,Generation);Before:=View.Document.ToJSON;
 RecordValue:=View.Calculations;
 try
  Check(RecordValue.GetValue<TJSONArray>('rows').Count=3,'Arithmetic expressions and constant formula captured without nested duplicates or literal false positives');
  Check(not RecordValue.ToJSON.Contains('secret-number'),'Calculation projection omits original literal contents');
  Check(RecordValue.ToJSON.Contains('AnnualHours'),'Constant declaration formula retained');
  Row:=RecordValue.GetValue<TJSONArray>('rows')[1] as TJSONObject;
  Check(Row.GetValue<string>('target_key')<>'','Captured expression links its actual enclosing routine');
  Check(Row.GetValue<string>('source_hash')=SourceHash,'Candidate retains captured source hash');
  Check(Row.GetValue<Int64>('generation_id')=Generation,'Candidate retains generation');
  Check(Row.GetValue<string>('business_meaning')='Unknown','Business meaning never invented');
  Check(Row.GetValue<string>('units')='Unknown','Units never inferred from operators');
  Check(TDPHWorkspaceView.DescribeCalculationEvidence(Row).Contains('not evaluated'),'Candidate inspector explains evaluation boundary');
 finally RecordValue.Free;end;
 CandidateDoc:=View.Document.Clone as TJSONObject;
 try
  Rows:=nil;for Value in CandidateDoc.GetValue<TJSONArray>('syntax.files') do if Value.GetValue<string>('path')='main.pas' then Rows:=Value.GetValue<TJSONArray>('ir.nodes');
  for Value in Rows do if Value.GetValue<string>('kind')='declaration_const' then begin RecordValue:=Value as TJSONObject;RecordValue.RemovePair('value').Free;RecordValue.AddPair('value','');Break;end;
  CandidateView:=TDPHWorkspaceView.Create(CandidateDoc);CandidateDoc:=nil;
  try CandidateResult:=CandidateView.Calculations;try Check(CandidateResult.GetValue<Integer>('unavailable_expressions')=1,'Unavailable bounded formula text explicitly counted');Check(CandidateResult.GetValue<TJSONArray>('rows').Count=2,'Unavailable formula not silently projected as complete');finally CandidateResult.Free;end;finally CandidateView.Free;end;
 finally CandidateDoc.Free;end;
 CandidateDoc:=View.Document.Clone as TJSONObject;
 try
  Rows:=nil;for Value in CandidateDoc.GetValue<TJSONArray>('syntax.files') do if Value.GetValue<string>('path')='main.pas' then Rows:=Value.GetValue<TJSONArray>('ir.nodes');Check(Rows<>nil,'Main calculation source fixture available');
  Node:=nil;for Value in Rows do if Value.GetValue<string>('kind')='declaration_const' then begin Node:=Value as TJSONObject;Break;end;
  Check(Node<>nil,'Constant formula fixture supports bounded projection checks');
  for I:=1 to 10001 do begin RecordValue:=Node.Clone as TJSONObject;RecordValue.RemovePair('start').Free;RecordValue.AddPair('start',TJSONNumber.Create(1000+I));Rows.AddElement(RecordValue);end;
  CandidateView:=TDPHWorkspaceView.Create(CandidateDoc);CandidateDoc:=nil;
  try CandidateResult:=CandidateView.Calculations;try Check(CandidateResult.GetValue<TJSONArray>('rows').Count=10000,'Candidate inventory enforces 10000-row bound');Check(CandidateResult.GetValue<string>('limit','')<>'','Inventory truncation explicitly reported');finally CandidateResult.Free;end;finally CandidateView.Free;end;
 finally CandidateDoc.Free;end;
