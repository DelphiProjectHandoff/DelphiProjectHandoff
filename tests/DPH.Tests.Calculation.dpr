 Check(TDPHWorkspaceView.DescribeCalculation(Row).Contains('Explicit implementation/evidence links: 2'),'Inspector distinguishes resolved link count');
 finally Row.Free;end;
 Check(SaveCalculation(0,0,CalculationTitle,Body,'Author','business_rule','maintenance','maintainer','',Metadata),'Duplicate calculation identity rejected');
 Check(SaveCalculation(CalculationID,Revision,CalculationTitle,Body,'Author','business_rule','maintenance','maintainer','','{}'),'Typed metadata cannot be discarded');
 RecordValue:=TJSONObject.ParseJSONValue(Metadata) as TJSONObject;RecordValue.RemovePair('calculation_id').Free;RecordValue.AddPair('calculation_id',TGUID.NewGuid.ToString);try Check(SaveCalculation(CalculationID,Revision,CalculationTitle,Body,'Author','business_rule','maintenance','maintainer','',RecordValue.ToJSON),'Saved calculation identity cannot change');finally RecordValue.Free;end;
 Denied:=False;try Store.ReviewKnowledge(CalculationID,Revision,Generation,'','verified');except Denied:=True;end;Check(Denied,'Anonymous calculation review rejected');
 OldRevision:=Revision;Store.ReviewKnowledge(CalculationID,Revision,Generation,'Calculation reviewer','verified');Row:=LoadCalculation;try Revision:=StrToInt64(Row.GetValue<string>('revision'));Check(Row.GetValue<string>('reviewer')='Calculation reviewer','Named reviewer persists');Check(Row.GetValue<TJSONArray>('history').Count=2,'Review appends immutable history');Check(Row.GetValue<TJSONArray>('rich_links').Count=2,'Review retains exact implementation links');finally Row.Free;end;
 Check(SaveCalculation(CalculationID,OldRevision,CalculationTitle,Body,'Editor','business_rule','maintenance','maintainer','',Metadata),'Stale calculation edit rejected');
 RecordValue:=TJSONObject.ParseJSONValue(Metadata) as TJSONObject;
 try
  Row:=RecordValue.GetValue<TJSONObject>('fields');Row.RemovePair('outputs').Free;Row.AddPair('outputs','Rounded invoice total and currency code');
  Metadata:=RecordValue.ToJSON;Body:=TDPHWorkspaceView.CalculationBody(RecordValue);
 finally RecordValue.Free;end;
 Store.SaveKnowledge(CalculationID,Revision,Generation,CalculationTitle,Body,'Second author','business_rule','','maintenance','maintainer','','',Metadata);
 Row:=LoadCalculation;try Check(Row.GetValue<string>('state')='needs_review','Calculation edits reopen review');Check(Row.GetValue<TJSONArray>('history').Count=3,'Prior reviewed calculation retained');Check(Row.GetValue<TJSONArray>('rich_links').Count=2,'Calculation revision preserves implementation links');Check(Row.GetValue<string>('body').Contains('currency code'),'Changed structured output persists');finally Row.Free;end;
 Row:=LoadCalculation;try Revision:=StrToInt64(Row.GetValue<string>('revision'));finally Row.Free;end;
 Check(SaveCalculation(CalculationID,Revision,CalculationTitle,Body+sLineBreak+'invented prose','Editor','business_rule','maintenance','maintainer','',Metadata),'Structured calculation body cannot diverge from fields');
 Check(Store.IntegrityCheck='ok','Calculation database integrity valid');
 Rows:=Store.KnowledgeJSON;try Model:=TDPHDocumentModel.Create(View,Rows,[],[],False,False,nil,False,'maintainer');
 try
 Check(Model.Document.ToJSON.Contains('Invoice total'),'Maintainer publication includes authored calculation');
 Check(Model.Document.ToJSON.Contains('dimensionless fraction'),'Publication retains authored units and conversions');Check(Model.Document.ToJSON.Contains('two decimal places'),'Publication retains authored rounding policy');
 Check(Model.Document.ToJSON.Contains('calculation_definition'),'Canonical handoff preserves typed calculation identity');
 if TDirectory.Exists(TPath.Combine(Work,'handoff')) then begin
  RecordValue:=TJSONObject.ParseJSONValue(TFile.ReadAllText(TPath.Combine(Work,'handoff\manifest.json'),TEncoding.UTF8)) as TJSONObject;
  try if RecordValue.GetValue<string>('project','')<>'Operations.dpr' then raise Exception.Create('Refusing to replace an unrelated test export');finally RecordValue.Free;end;
  TDirectory.Delete(TPath.Combine(Work,'handoff'),True);
 end;
 TDPHPublisher.Export(Model,Store,TPath.Combine(Work,'handoff'));
 TDPHPublisher.Validate(TPath.Combine(Work,'handoff'),Model.Document.GetValue<string>('input_fingerprint'));
 Check(True,'Business calculation handoff passes full bundle validation');
 Check(TFile.ReadAllText(TPath.Combine(Work,'handoff\index.html'),TEncoding.UTF8).Contains('Subtotal and tax rate from approved invoice'),'Published HTML includes structured inputs');
 finally Model.Free;end;finally Rows.Free;end;
 DatabaseName:=Store.DatabasePath;FreeAndNil(Store);Store:=TDPHKnowledgeStore.Create(DatabaseName,Fixture,TPath.Combine(Root,'migrations'));Store.SelectConfiguration(Config);
 Row:=LoadCalculation;try Check(Row<>nil,'Business calculation survives database close and reopen');Check(Row.GetValue<string>('structured_json')=Metadata,'Exact structured fields survive reopening');Check(Row.GetValue<TJSONArray>('history').Count=3,'Immutable review and edit history survives reopening');Check(Row.GetValue<TJSONArray>('rich_links').Count=2,'Exact source and procedure links survive reopening');finally Row.Free;end;
 Catalog:=TDPHWorkspaceCatalog.DefaultPath;CatalogHash:='';if TFile.Exists(Catalog) then CatalogHash:=THashSHA2.GetHashStringFromFile(Catalog);
 Form:=TDPHMainForm.Create(nil);
 try Form.PollTimer.Enabled:=False;Form.ChangeTimer.Enabled:=False;Form.LoadView(View.Document.Clone as TJSONObject);Form.LoadKnowledge(Store.KnowledgeJSON);
 for Body in ['Calculations','Calculation fields','Calculation evidence'] do begin Form.WorkspacePageCombo.ItemIndex:=Form.WorkspacePageCombo.Items.IndexOf(Body);Check(Form.WorkspacePageCombo.ItemIndex>=0,'Calculation page listed in serialized header selector');Form.WorkspacePageChange(Form.WorkspacePageCombo);Check(Form.WorkspaceTabs.ActiveTab.Text=Body,'Calculation page opens through actual header selector');end;
 Check(Form.CalculationEvidenceList.Count=3,'Native source candidate inventory available after load');
 Form.CalculationEvidenceList.ItemIndex:=1;Form.CalculationEvidenceSelectionChange(nil);Form.CalculationEvidenceExplainClick(nil);
 Check(Form.WorkspaceTabs.ActiveTab=Form.ExplainTab,'Candidate opens captured routine explanation');
 Form.CalculationEvidenceFilter.Text:='Round';Form.CalculationEvidenceFilterChange(nil);Check(Form.CalculationEvidenceList.Count=1,'Native candidate search filters formula text');
 Form.CalculationEvidenceFilter.Text:='';Form.CalculationEvidenceFilterChange(nil);
 Form.CalculationEvidenceList.ItemIndex:=1;Form.CalculationEvidenceSelectionChange(nil);Form.WorkspaceTabs.ActiveTab:=Form.CalculationEvidenceTab;
 Form.Show;Render('phase1-calculation-evidence.png');Form.WindowState:=TWindowState.wsNormal;Form.Width:=960;Form.Height:=600;Render('phase1-calculation-evidence-compact.png');Form.Hide;
 Form.CalculationEvidenceDefineClick(nil);Check(Form.WorkspaceTabs.ActiveTab=Form.CalculationEditorTab,'New definition opens typed calculation fields');
 Check(Form.Calc_formula.Text.Contains('Subtotal'),'Candidate prefill retains captured formula');
 Check(Form.Calc_meaning.Text='Unknown','Candidate prefill leaves business meaning unresolved');
 Check(Form.Calc_assumptions.Text.Contains(SourceHash),'Candidate prefill retains source identity for review');
 Form.CalculationEvidenceDefineClick(nil);Check(Form.StatusLabel.Text.Contains('Save or discard'),'Candidate cannot overwrite pending definition');Form.DiscardKnowledgeClick(nil);
 Check(Form.CalculationList.Count=1,'Native register includes calculation and excludes unrelated procedure');Check(Form.CalculationMemo.Text.Contains('Second author'),'Native inspector shows current contributor');
 Form.PendingKnowledgeCheck.IsChecked:=True;Form.CalculationOpenClick(nil);Check(Form.WorkspaceTabs.ActiveTab=Form.KnowledgeTab,'Open plan enters saved Knowledge workflow');Check(Form.KnowledgeBodyMemo.ReadOnly,'Saved structured body protected from free text edits');Check(Form.KnowledgeTitleEdit.ReadOnly,'Saved stable title protected');Check(not Form.KnowledgeKindCombo.Enabled,'Saved calculation kind protected');
 Form.CalculationOpenClick(Form.CalculationLinks);Check(Form.WorkspaceTabs.ActiveTab=Form.KnowledgeLinksTab,'Implementation links opens exact link workflow');Check(Form.KnowledgeLinksList.Count=2,'Native exact implementation links available');Form.KnowledgeLinksList.ItemIndex:=0;Form.OpenKnowledgeLinkClick(nil);Check(Form.WorkspaceTabs.ActiveTab=Form.ExplainTab,'Saved implementation routine opens captured explanation');
 Form.CalculationEditClick(nil);Check(Form.WorkspaceTabs.ActiveTab=Form.CalculationEditorTab,'Edit opens native structured fields');Check(Form.Calc_units.Text.Contains('dimensionless fraction'),'Native editor restores precise authored units');
 Check(Form.Calc_inputs.Text='Subtotal and tax rate from approved invoice','Native editor restores persisted input');Check(Form.Calc_name.ReadOnly,'Saved calculation name remains stable');
 Form.WindowState:=TWindowState.wsNormal;Form.Width:=1600;Form.Height:=900;Form.Show;Render('phase1-calculation-editor.png');Form.WindowState:=TWindowState.wsNormal;Form.Width:=960;Form.Height:=600;Render('phase1-calculation-editor-compact.png');Check(Form.CalculationEditorToolbar.ShowScrollBars,'Compact editor commands scroll horizontally');Form.CalculationEditorScroll.ViewportPosition:=PointF(0,1400);Render('phase1-calculation-editor-bottom.png');Check(Form.Calc_unknowns.Height>50,'Unknowns field retains editable height');Form.Hide;
 Form.Calc_outputs.Text:='Revised native output';Form.CalculationAuthor.Text:='Native contributor';Form.CalculationApplyClick(nil);Check(Form.WorkspaceTabs.ActiveTab=Form.KnowledgeTab,'Apply prepares Knowledge draft');Check(Form.KnowledgeBodyMemo.Text.Contains('Revised native output'),'Native structured edit generates canonical body');
 Body:=Form.KnowledgeBodyMemo.Text;Form.CalculationOpenClick(nil);Check(Form.KnowledgeBodyMemo.Text=Body,'Unsaved structured draft protected from selection');Form.CalculationNewClick(nil);Check(Form.StatusLabel.Text.Contains('Save or discard'),'Unsaved structured draft protected from replacement');Form.DiscardKnowledgeClick(nil);
 Form.CalculationNewClick(nil);Check(Form.WorkspaceTabs.ActiveTab=Form.CalculationEditorTab,'New calculation opens structured editor');Check(not Form.Calc_name.ReadOnly,'New calculation name editable');
 Form.Calc_name.Text:='Anonymous fixture';Form.CalculationAuthor.Text:='';Form.CalculationApplyClick(nil);Check(Form.WorkspaceTabs.ActiveTab=Form.CalculationEditorTab,'Anonymous contributor keeps calculation in editor');
 Form.Calc_name.Text:='Native calculation';Form.CalculationAuthor.Text:='Native contributor';Form.CalculationApplyClick(nil);Check(Form.KnowledgeBodyMemo.Text.Contains('CALCULATION DEFINITION'),'New native calculation canonical body prepared');Check(Form.KnowledgeBodyMemo.ReadOnly,'Canonical draft body protected');Form.DiscardKnowledgeClick(nil);
 Form.CalculationState.ItemIndex:=2;Form.CalculationFilterChange(nil);Check(Form.CalculationList.Count=0,'Review-state filter respects pending edit');Form.CalculationState.ItemIndex:=0;Form.CalculationFilter.Text:='Subtotal and tax rate';Form.CalculationFilterChange(nil);Check(Form.CalculationList.Count=1,'Calculation text search finds authored input');
 Form.CalculationFilter.Text:='absent';Form.CalculationFilterChange(nil);Check(Form.CalculationMemo.Text.Contains('Empty results do not prove'),'Empty register explains unresolved obligations');Check(not Form.CalculationOpen.Enabled,'Empty results disable opening');
 Form.CalculationFilter.Text:='';Form.CalculationFilterChange(nil);Form.WorkspaceTabs.ActiveTab:=Form.CalculationTab;Form.WindowState:=TWindowState.wsNormal;Form.Width:=1600;Form.Height:=900;Form.Show;Render('phase1-calculation-workspace.png');Form.WindowState:=TWindowState.wsNormal;Form.Width:=960;Form.Height:=600;Render('phase1-calculation-compact.png');Check(Form.CalculationMemo.Height>=50,'Compact calculation detail remains readable');Check(Form.CalculationToolbar.ShowScrollBars and Form.CalculationMemo.ShowScrollBars,'Compact commands and long policies scroll');Form.Hide;
 Policies:=TJSONArray.Create;Row:=LoadCalculation;try for I:=1 to 270 do begin RecordValue:=Row.Clone as TJSONObject;Policies.AddElement(RecordValue);end;finally Row.Free;end;Form.LoadKnowledge(Policies);Check(Form.CalculationList.Count=250,'Large register first page bounded');Check(Form.CalculationNext.Enabled,'Large register next page accessible');Form.CalculationFilterChange(Form.CalculationNext);Check(Form.CalculationList.Count=20,'Remaining calculation rows accessible');
