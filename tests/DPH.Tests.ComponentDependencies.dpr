procedure Check(OK:Boolean;const S:string);
begin if not OK then raise Exception.Create('FAIL '+S);Inc(Checks);Writeln('PASS ',Checks,': ',S);Flush(Output);end;
function Find(const Name:string):TJSONObject;
var V:TJSONValue;
begin Result:=nil;for V in Report.GetValue<TJSONArray>('rows') do if V.GetValue<string>('name')=Name then Exit(V as TJSONObject);end;
function Save(Expected:Int64;const Body:string=''):Int64;
var B:string;
begin B:=Body;if B='' then B:=TDPHComponentDependency.Body(RecordValue);Result:=Store.SaveKnowledge(Knowledge,Expected,Generation,TDPHComponentDependency.Title(RecordValue),B,'Dependency Test Author','engineering_rule','','engineering','engineer','','',RecordValue.ToJSON);end;
procedure Render(const Name:string);
begin Application.ProcessMessages;Bitmap:=TBitmap.Create(Form.ClientWidth,Form.ClientHeight);try if Bitmap.Canvas.BeginScene then try Form.PaintTo(Bitmap.Canvas);finally Bitmap.Canvas.EndScene;end;Bitmap.SaveToFile(TPath.Combine(Root,'docs\'+Name));finally Bitmap.Free;end;end;
begin
 Application.Initialize;
 try
 Root:=TPath.GetFullPath(ParamStr(1));Work:=TPath.Combine(Root,'bin\component-dependencies-validation');Fixture:=TPath.Combine(Work,'source');TDirectory.CreateDirectory(Fixture);
 TFile.WriteAllText(TPath.Combine(Fixture,'Dependencies.dpr'),'program Dependencies; uses Main, VendorA, VendorB, Touch, BinaryLayout, VendorPackage in ''VendorPackage.dpk'', MissingVendor; begin end.',TEncoding.UTF8);
 TFile.WriteAllText(TPath.Combine(Fixture,'VendorPackage.dpk'),'package VendorPackage; requires rtl; contains VendorA; end.',TEncoding.UTF8);
 TFile.WriteAllText(TPath.Combine(Fixture,'Main.pas'),'unit Main; interface uses VendorA, VendorB; implementation {$R *.dfm} end.',TEncoding.UTF8);
 TFile.WriteAllText(TPath.Combine(Fixture,'VendorA.pas'),'unit VendorA; interface type TWidget = class end; TDuplicate = class end; implementation end.',TEncoding.UTF8);
 TFile.WriteAllText(TPath.Combine(Fixture,'VendorB.pas'),'unit VendorB; interface type TDuplicate = class end; implementation end.',TEncoding.UTF8);
 TFile.WriteAllText(TPath.Combine(Fixture,'Touch.pas'),'unit Touch; interface implementation {$R *.fmx} end.',TEncoding.UTF8);
 TFile.WriteAllText(TPath.Combine(Fixture,'Touch.fmx'),'object TouchForm: TForm'+sLineBreak+' object TouchWidget: TWidget'+sLineBreak+' end'+sLineBreak+'end',TEncoding.UTF8);
 TFile.WriteAllText(TPath.Combine(Fixture,'BinaryLayout.pas'),'unit BinaryLayout; interface implementation {$R *.dfm} end.',TEncoding.UTF8);
 Input:=TStringStream.Create('object BinaryForm: TForm'+sLineBreak+' object BinaryWidget: TWidget'+sLineBreak+' end'+sLineBreak+'end');Binary:=TMemoryStream.Create;
 try ObjectTextToBinary(Input,Binary);Binary.SaveToFile(TPath.Combine(Fixture,'BinaryLayout.dfm'));finally Binary.Free;Input.Free;end;
 Text:='object MainForm: TForm'+sLineBreak+' object Known: TWidget'+sLineBreak+' end'+sLineBreak+' object Unknown: TMissingWidget'+sLineBreak+' end'+sLineBreak+' object Ambiguous: TDuplicate'+sLineBreak+' end'+sLineBreak+' object Qualified: VendorA.TDuplicate'+sLineBreak+' end'+sLineBreak+' inherited InheritedWidget: TWidget'+sLineBreak+' end'+sLineBreak;
 for I:=1 to 270 do Text:=Text+' object Extra'+IntToStr(I)+': TWidget'+sLineBreak+' end'+sLineBreak;
 TFile.WriteAllText(TPath.Combine(Fixture,'Main.dfm'),Text+'end',TEncoding.UTF8);Hash:=THashSHA2.GetHashStringFromFile(TPath.Combine(Fixture,'Main.dfm'));
 Analyzer:=TDPHAnalyzer.Create;Semantic:=TDPHSemanticAnalyzer.Create;
 try Scan:=Analyzer.Scan(TPath.Combine(Fixture,'Dependencies.dpr'),'Debug','Win32',[],[],False);try Manifest:=Scan.Inventory.Manifest;Graph:=Semantic.Analyze(Scan);try View:=TDPHWorkspaceView.Create(TDPHWorkspaceView.Capture(Scan,Graph,1,'Dependencies.dpr','Debug','Win32',[],[]));finally Graph.Free;end;finally Scan.Free;end;finally Semantic.Free;Analyzer.Free;end;
