 Check(Find('Known').GetValue<TJSONArray>('class_candidates').Items[0].GetValue<string>('source_hash')<>'','Class candidate fingerprint retained');
 Check(Find('Unknown').GetValue<string>('resolution').Contains('unresolved'),'Missing class remains unresolved');
 Check(Find('Ambiguous').GetValue<TJSONArray>('class_candidates').Count=2,'Duplicate class names remain ambiguous');
 Check(Find('Qualified').GetValue<TJSONArray>('class_candidates').Count=1,'Qualified class narrows lexical candidate');
 Check(Find('TouchWidget')<>nil,'FMX component included');Check(Find('BinaryWidget')<>nil,'Binary DFM component included');
 Check(Find('InheritedWidget').GetValue<string>('declaration')='inherited','Inherited declaration preserved');
 Check(Report.GetValue<TJSONArray>('packages').Count=1,'Captured package declaration retained');
 Check(Report.GetValue<TJSONArray>('unavailable_inputs').Count>0,'Unavailable dependencies distinguished');
 Check(Report.GetValue<string>('qualification').Contains('No target classes'),'No component loading qualification explicit');
 Check(TDPHComponentDependencies.Describe(Find('Unknown'),nil).Contains('No attributed dependency record'),'Unauthored dependency is explicit');
 Check(TDPHComponentDependencies.Describe(Find('Known'),nil).Contains('does not guess vendor'),'Origin never guessed from class prefix');
 Check(TDPHKeyboardInspector.ReadSource(View,TPath.Combine(Fixture,'Dependencies.dpr'),Find('Known'),Find('Known').GetValue<TJSONObject>('range')).Contains('Known'),'Matching source navigation verified');
 Rejected:=False;try TDPHKeyboardInspector.ReadSource(View,TPath.Combine(Fixture,'Dependencies.dpr'),Find('BinaryWidget'),Find('BinaryWidget').GetValue<TJSONObject>('range'));except Rejected:=True;end;Check(Rejected,'Binary source does not pretend to be text');
 TFile.AppendAllText(TPath.Combine(Fixture,'Main.dfm'),sLineBreak,TEncoding.UTF8);Rejected:=False;try TDPHKeyboardInspector.ReadSource(View,TPath.Combine(Fixture,'Dependencies.dpr'),Find('Known'),Find('Known').GetValue<TJSONObject>('range'));except Rejected:=True;end;Check(Rejected,'Changed source navigation refused');TFile.WriteAllText(TPath.Combine(Fixture,'Main.dfm'),Text+'end',TEncoding.UTF8);
 RecordValue:=TJSONObject.Create.AddPair('record_type','component_dependency').AddPair('fields',TJSONObject.Create.AddPair('class_name','TMissingWidget'));Fields:=RecordValue.GetValue<TJSONObject>('fields');
 try
 Rejected:=False;try TDPHComponentDependency.Validate(RecordValue);except Rejected:=True;end;Check(Rejected,'Evidence required');Fields.AddPair('evidence','Synthetic controlled fixture; supplier and runtime behavior unverified');
 Check(TDPHComponentDependency.Body(RecordValue).Contains('Not supplied; remains unknown.'),'Blank optional fields explicit');
 Fields.AddPair('unexpected','bad');Rejected:=False;try TDPHComponentDependency.Validate(RecordValue);except Rejected:=True;end;Check(Rejected,'Unknown fields rejected');Fields.RemovePair('unexpected').Free;
 Fields.AddPair('version',TJSONNumber.Create(1));Rejected:=False;try TDPHComponentDependency.Validate(RecordValue);except Rejected:=True;end;Check(Rejected,'Nontext fields rejected');Fields.RemovePair('version').Free;
 Fields.AddPair('version',StringOfChar('x',4097));Rejected:=False;try TDPHComponentDependency.Validate(RecordValue);except Rejected:=True;end;Check(Rejected,'Oversized fields rejected');Fields.RemovePair('version').Free;
 Fields.AddPair('package_name','Fixture Widgets');Fields.AddPair('vendor','Fixture Supplier');Fields.AddPair('version','1.2 test');Fields.AddPair('support','Fixture maintainer; review replacement license');
 DatabasePath:=TPath.Combine(Work,'dependencies.dphdb');if TFile.Exists(DatabasePath) then TFile.Delete(DatabasePath);
 Store:=TDPHKnowledgeStore.Create(DatabasePath,Fixture,TPath.Combine(Root,'migrations'));
 try Store.InitializeProject('Component dependency fixture','Delphi');Configuration:=Store.AddConfiguration('Win32','37.0','[]','[]','Debug');Store.SelectConfiguration(Configuration);Store.ObserveManifest(Manifest);Generation:=Store.BeginGeneration(Configuration,'dependency-fixture',Manifest);
 Check(not Store.PublishGeneration(Generation,Manifest,'{}',False),'Partial capture remains explicitly incomplete');
 Knowledge:=Save(0);KnowledgeRows:=Store.KnowledgeJSON;
 try Row:=KnowledgeRows.Items[0] as TJSONObject;Revision:=StrToInt64(Row.GetValue<string>('revision'));
 Check(Row.GetValue<string>('structured_json')=RecordValue.ToJSON,'Exact fields persist');Check(Row.GetValue<string>('state')='needs_review','Save requires explicit review');Check(Row.GetValue<string>('editor')='Dependency Test Author','Named author retained');
 Check(TDPHComponentDependencies.FindRecord(KnowledgeRows,'tmissingwidget')=Row,'Class matching ignores case');
 Check(TDPHComponentDependencies.Describe(Find('Unknown'),KnowledgeRows).Contains('Fixture Supplier'),'Authored vendor shown beside source evidence');
 Check(Find('Unknown').GetValue<string>('resolution').Contains('unresolved'),'Authored metadata does not resolve source');
 Model:=TDPHDocumentModel.Create(View,KnowledgeRows,[],[],False,False);try Check(Model.Document.ToJSON.Contains('Fixture Supplier') and Model.Document.ToJSON.Contains('component_dependency'),'Publication carries readable and structured attributed records');finally Model.Free;end;
 finally KnowledgeRows.Free;end;
 Rejected:=False;try Store.SaveKnowledge(0,0,Generation,TDPHComponentDependency.Title(RecordValue),TDPHComponentDependency.Body(RecordValue),'Other Author','engineering_rule','','engineering','engineer','','',RecordValue.ToJSON);except Rejected:=True;end;Check(Rejected,'Duplicate class record rejected');
 Fields.RemovePair('class_name').Free;Fields.AddPair('class_name','tmissingwidget');Rejected:=False;try Store.SaveKnowledge(0,0,Generation,TDPHComponentDependency.Title(RecordValue),TDPHComponentDependency.Body(RecordValue),'Other Author','engineering_rule','','engineering','engineer','','',RecordValue.ToJSON);except Rejected:=True;end;Check(Rejected,'Duplicate class identity ignores case');Fields.RemovePair('class_name').Free;Fields.AddPair('class_name','DifferentClass');Rejected:=False;try Save(Revision);except Rejected:=True;end;Check(Rejected,'Existing record cannot change class identity');Fields.RemovePair('class_name').Free;Fields.AddPair('class_name','TMissingWidget');
 Rejected:=False;try Save(Revision,'Contradictory body');except Rejected:=True;end;Check(Rejected,'Structured and readable fields cannot diverge');
 Rejected:=False;try Store.SaveKnowledge(Knowledge,Revision,Generation,TDPHComponentDependency.Title(RecordValue),TDPHComponentDependency.Body(RecordValue),'Author','engineering_rule','','engineering','engineer');except Rejected:=True;end;Check(Rejected,'Ordinary editing cannot discard structured fields');
 Store.ReviewKnowledge(Knowledge,Revision,Generation,'Named Dependency Reviewer','verified');KnowledgeRows:=Store.KnowledgeJSON;try Row:=KnowledgeRows.Items[0] as TJSONObject;Reviewed:=StrToInt64(Row.GetValue<string>('revision'));Check((Row.GetValue<string>('state')='verified') and (Row.GetValue<string>('body')=TDPHComponentDependency.Body(RecordValue)),'Review preserves fields and attributes reviewer');finally KnowledgeRows.Free;end;
 Rejected:=False;try Save(Revision);except Rejected:=True;end;Check(Rejected,'Stale editor cannot overwrite review');
 Fields.RemovePair('version').Free;Fields.AddPair('version','1.3 test');Knowledge:=Save(Reviewed);KnowledgeRows:=Store.KnowledgeJSON;try Row:=KnowledgeRows.Items[0] as TJSONObject;Check((Row.GetValue<TJSONArray>('history').Count=3) and (Row.GetValue<string>('state')='needs_review'),'Editing preserves immutable history and reopens review');finally KnowledgeRows.Free;end;
 Store.BuildSearchIndex(Generation);KnowledgeRows:=Store.SearchProject(Generation,'Fixture Supplier','',0);try Check(KnowledgeRows.Count>0,'Dependency records participate in search');finally KnowledgeRows.Free;end;
 Check(Store.IntegrityCheck='ok','Database integrity preserved');
 finally Store.Free;end;
 Store:=TDPHKnowledgeStore.Create(DatabasePath,Fixture,TPath.Combine(Root,'migrations'));try KnowledgeRows:=Store.KnowledgeJSON;try Check(KnowledgeRows.Items[0].GetValue<string>('structured_json')=RecordValue.ToJSON,'Reopen retains dependency fields');finally KnowledgeRows.Free;end;finally Store.Free;end;
 Editor:=TDPHComponentDependencyForm.Create(nil);try Editor.LoadRecord(RecordValue,'Native Test Author');Editor.ApplyProfileClick(nil);Check(Editor.ModalResult=mrOk,'Serialized editor validates attributed record');Row:=Editor.RecordJSON;try Rejected:=False;for Text in DPHComponentDependencyKeys do if Row.GetValue<string>('fields.'+Text,'')<>RecordValue.GetValue<string>('fields.'+Text,'') then Rejected:=True;Check(not Rejected,'Editor round trips every field');finally Row.Free;end;Check(Editor.Profile_class_name.ReadOnly,'Class identity cannot be casually reassigned');Editor.ProfileAuthorEdit.Text:='';Editor.ModalResult:=mrNone;Editor.ApplyProfileClick(nil);Check(Editor.ModalResult<>mrOk,'Editor requires contributor');Editor.Free;Editor:=TDPHComponentDependencyForm.Create(nil);Editor.LoadRecord(RecordValue,'Native Test Author');Editor.Show;Application.ProcessMessages;Bitmap:=TBitmap.Create(Editor.ClientWidth,Editor.ClientHeight);try if Bitmap.Canvas.BeginScene then try Editor.PaintTo(Bitmap.Canvas);finally Bitmap.Canvas.EndScene;end;Bitmap.SaveToFile(TPath.Combine(Root,'docs\phase1-component-dependency-editor.png'));finally Bitmap.Free;end;Editor.Hide;finally Editor.Free;end;
 Catalog:=TDPHWorkspaceCatalog.DefaultPath;CatalogHash:='';if TFile.Exists(Catalog) then CatalogHash:=THashSHA2.GetHashStringFromFile(Catalog);
 Form:=TDPHMainForm.Create(nil);try Form.PollTimer.Enabled:=False;Form.ChangeTimer.Enabled:=False;Form.LoadView(View.Document.Clone as TJSONObject);
 Check(Form.DependencyList.Count=250,'Native page bounds 250 rows');Check(Form.DependencyNextButton.Enabled,'Further rows enable Next');Form.DependencyFilterChange(Form.DependencyNextButton);Check(Form.DependencyList.Count=Report.GetValue<Integer>('total')-250,'Next shows remaining rows');Check(not Form.DependencyNextButton.Enabled,'Last page disables Next');Form.DependencyFilterChange(Form.DependencyFirstButton);Check(Form.DependencyList.Count=250,'First resets page');
 Check(Form.WorkspacePageCombo.Items.IndexOf('Component dependencies')>=0,'Page discoverable in selector');
 Form.DependencyFilterEdit.Text:='COMPONENT DEPENDENCY Known :';Form.DependencyFilterChange(nil);Check(Form.DependencyClassButton.Enabled,'Unique candidate enables Explain class');Form.DependencyClassClick(nil);Check(Form.WorkspaceTabs.ActiveTab=Form.ExplainTab,'Explain class navigates captured declaration');Form.DependencyFilterEdit.Text:='COMPONENT DEPENDENCY Ambiguous :';Form.DependencyFilterChange(nil);Check(not Form.DependencyClassButton.Enabled,'Ambiguous class disables Explain');
 Form.DependencyFilterEdit.Text:='COMPONENT DEPENDENCY Unknown :';Form.DependencyFilterChange(nil);Check(Form.DependencyList.Count=1,'Filter finds exact component');Check(Form.DependencyMemo.Text.Contains('unresolved class'),'Native details explain missing source');Check(not Form.DependencyClassButton.Enabled,'Unresolved class disables Explain');Check(Form.DependencyEditButton.Enabled,'Selected component enables editor');Check(not Form.DependencyKnowledgeButton.Enabled,'Missing record disables Knowledge navigation');Form.DependencySourceClick(nil);Check(Form.DependencyMemo.Text.Contains('Source is detached'),'Detached source refused');
 Store:=TDPHKnowledgeStore.Create(DatabasePath,Fixture,TPath.Combine(Root,'migrations'));try Form.LoadKnowledge(Store.KnowledgeJSON);finally Store.Free;end;
 Check(Form.DependencyMemo.Text.Contains('Fixture Supplier'),'Native view refreshes saved metadata');Check(Form.DependencyKnowledgeButton.Enabled,'Saved record enables Knowledge navigation');Form.DependencyKnowledgeClick(nil);Check((Form.WorkspaceTabs.ActiveTab=Form.KnowledgeTab) and Form.KnowledgeBodyMemo.Text.Contains('Fixture Supplier'),'Knowledge command opens saved immutable revision');
 Form.KnowledgeBodyMemo.ReadOnly:=False;Form.KnowledgeBodyMemo.Text:='unsaved fixture draft';Form.KnowledgeEdited(nil);Form.DependencyKnowledgeClick(nil);Check(Form.StatusLabel.Text.Contains('Save or discard'),'Navigation protects unsaved Knowledge draft');Form.DiscardKnowledgeClick(nil);
 Form.DependencyFilterEdit.Text:='absent xyz';Form.DependencyFilterChange(nil);Check((Form.DependencyList.Count=0) and not Form.DependencyEditButton.Enabled and not Form.DependencySourceButton.Enabled,'Empty result clears actions');
 Form.DependencyFilterEdit.Text:='COMPONENT DEPENDENCY Unknown :';Form.DependencyFilterChange(nil);Form.WorkspaceTabs.ActiveTab:=Form.DependencyTab;Form.Show;Render('phase1-component-dependencies-workspace.png');Form.WindowState:=TWindowState.wsNormal;Form.Width:=960;Form.Height:=600;Render('phase1-component-dependencies-compact.png');Check(Form.DependencyMemo.Height>=60,'Compact details remain visible');Check(Form.DependencyToolbar.ShowScrollBars,'Compact toolbar scrolls');Form.Hide;
 CopyDoc:=View.Document.Clone as TJSONObject;CopyDoc.GetValue<TJSONObject>('syntax').RemovePair('files').Free;CopyDoc.GetValue<TJSONObject>('syntax').AddPair('files',TJSONArray.Create);Form.LoadView(CopyDoc);Check(Form.DependencyList.Count=0,'Replacement capture clears stale rows');
 finally Form.Free;end;
 Check((not TFile.Exists(Catalog) and (CatalogHash='')) or (TFile.Exists(Catalog) and (THashSHA2.GetHashStringFromFile(Catalog)=CatalogHash)),'User catalog unchanged');Check(THashSHA2.GetHashStringFromFile(TPath.Combine(Fixture,'Main.dfm'))=Hash,'Selected source unchanged');
 finally RecordValue.Free;end;
 TFile.WriteAllText(TPath.Combine(Root,'docs\phase1-component-dependencies-validation.json'),TJSONObject.Create.AddPair('result','PASS').AddPair('checks',TJSONNumber.Create(Checks)).AddPair('qualification','Real parser, SQLite persistence/review/search/publication and instantiated native DPH forms. No vendor classes are loaded. PaintTo renders are not target-runtime screenshots.').ToJSON,TEncoding.UTF8);
 finally Report.Free;end;finally Keyboard.Free;end;finally View.Free;end;
 Writeln('Component dependency validation passed: ',Checks,' checks.');
 except on E:Exception do begin Writeln(E.ClassName,': ',E.Message);ExitCode:=1;end;end;
end.
