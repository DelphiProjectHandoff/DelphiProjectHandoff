      Position.X = 12
      Position.Y = 26
      Width = 270
      Height = 30
    end
    object ApplyProfileButton: TButton
      Position.X = 292
      Position.Y = 26
      Width = 210
      Height = 30
      Text = 'Apply to Knowledge draft'
      OnClick = ApplyProfileClick
    end
