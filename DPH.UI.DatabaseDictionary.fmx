object DPHDatabaseDictionaryForm: TDPHDatabaseDictionaryForm
  Caption = 'Table or column business dictionary'
  ClientWidth = 820
  ClientHeight = 740
  Constraints.MinWidth = 620
  Constraints.MinHeight = 480
  Position = ScreenCenter
  object ProfilePurpose: TLabel
    Align = Top
    Height = 136
    Margins.Left = 12
    Margins.Right = 12
    WordWrap = True
    Text = 'Define the selected table or column for readers learning this project. Enter its business definition, owner or steward, sensitivity and evidence. State unknowns explicitly. Scroll down for captured identity fields; these are read only. Apply creates a Knowledge draft; Save there, then review explicitly. Do not enter actual confidential values.'
    StyledSettings = []
    TextSettings.Font.Size = 16
    TextSettings.FontColor = xFF146CB4
  end
  object ProfileToolbar: TLayout
    Align = Top
    Height = 92
    object ProfileAuthorLabel: TLabel
